diff --git a/src/config/marketplace.ts b/src/config/marketplace.ts
new file mode 100644
index 0000000000000000000000000000000000000000..715ecdb4ae850644225e1a693d3e6d5dc6fb627d
--- /dev/null
+++ b/src/config/marketplace.ts
@@ -0,0 +1,21 @@
+import type { OpenClawConfig } from "./types.openclaw.js";
+
+/** Native marketplace integration is enabled unless the operator opts out. */
+export function isMarketplaceEnabled(config?: Pick<OpenClawConfig, "marketplace">): boolean {
+  return config?.marketplace?.enabled !== false;
+}
+
+export class MarketplaceDisabledError extends Error {
+  constructor() {
+    super(
+      "Marketplace integration is disabled by marketplace.enabled. Use an explicit npm package or local artifact.",
+    );
+    this.name = "MarketplaceDisabledError";
+  }
+}
+
+export function assertMarketplaceEnabled(config?: Pick<OpenClawConfig, "marketplace">): void {
+  if (!isMarketplaceEnabled(config)) {
+    throw new MarketplaceDisabledError();
+  }
+}
