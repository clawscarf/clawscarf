+    const hello = z.object({ auth: z.object({ scopes: z.array(z.string()) }).optional() }).parse(
+      await client.request("connect", {
+        minProtocol: 4,
+        maxProtocol: 4,
+        client: { id: "gateway-client", version: "1.0.0", platform: "test", mode: "backend" },
+        role: "operator",
+        scopes: [],
+      }),
+    );
+    return { client, hello, closeEvents, closed: closed.promise };
+  }
+
+  it("enrolls, changes roles and removes a teammate without restarting or disconnecting the administrator", async () => {
+    // This also fails cleanly on the original restart policy, before scheduling SIGUSR1.
+    expect(
