{
  "id": "team-documents",
  "name": "Team documents",
  "description": "Illustrative starting point for a team document assistant. Document workflows and pack content are not supplied yet.",
  "maturity": "example",
  "defaults": {
    "resources": {
      "runtime": {
        "cpu": "4",
        "memory": "4Gi"
      }
    },
    "browser": {
      "enabled": false
    },
    "connections": {
      "enabled": true
    }
  },
  "models": {
    "defaultModel": "gpt-6-astra",
    "models": [
      {
        "id": "gpt-6-astra",
        "name": "GPT-6 Astra",
        "enabled": true,
        "contextWindow": 1050000,
        "maxTokens": 128000,
        "reasoning": true,
        "tools": true,
        "input": ["text", "image"],
        "route": {
          "model": "openai/gpt-6-astra",
          "apiKeyEnv": "OPENAI_API_KEY"
        }
      }
    ],
    "thinkingDefault": "medium"
  }
}
