-    if (!recorded) {
-      if (phase === "finished" && terminal) {
-        status =
-          run.status === "succeeded"
-            ? "completed"
-            : run.status === "skipped"
-              ? "skipped"
-              : "failed";
-      } else if (phase === run.phase) {
-        status = "in_progress";
-      } else if (terminal || index < currentIndex) {
-        // A phase absent from the durable timeline was not performed, even on success.
-        status = "skipped";
-      }
