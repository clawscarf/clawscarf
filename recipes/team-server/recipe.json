{
  "id": "team-server",
  "name": "Team server",
  "description": "A protected OpenClaw server for your team, with hosted login, managed models and optional Connections.",
  "maturity": "supported",
  "defaults": {
    "resources": {
      "runtime": {
        "cpu": "4",
        "memory": "4Gi"
      }
    },
    "browser": {
      "enabled": false
    },
    "connections": {
      "enabled": true
    },
    "publicWeb": true
  },
  "models": {
    "model": "gpt-6-astra",
    "provider": "openai",
    "reasoning": "medium"
  },
  "runtime": "../../runtime/current.json",
  "version": "0.1.3"
}
