{
  "id": "team-server",
  "name": "Team server",
  "description": "A shared OpenClaw workspace for your team.",
  "maturity": "supported",
  "defaults": {
    "agentName": "ClawScarf",
    "resources": {
      "runtime": {
        "cpu": "4",
        "memory": "4Gi"
      }
    },
    "browser": {
      "enabled": false
    },
    "connections": {
      "enabled": true
    },
    "publicWeb": true
  },
  "models": {
    "service": "cloud",
    "model": "gpt-6-astra",
    "reasoning": "medium"
  },
  "runtime": "../../runtime/current.json",
  "version": "0.1.5"
}
