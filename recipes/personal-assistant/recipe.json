{
  "id": "personal-assistant",
  "name": "Personal assistant",
  "description": "An OpenClaw assistant for your own research, writing and everyday work. Connect your accounts and invite others whenever you need.",
  "maturity": "supported",
  "defaults": {
    "agentName": "ClawScarf",
    "resources": {
      "runtime": {
        "cpu": "4",
        "memory": "4Gi"
      }
    },
    "browser": {
      "enabled": false
    },
    "connections": {
      "enabled": true
    },
    "publicWeb": true
  },
  "models": {
    "model": "gpt-6-astra",
    "provider": "openai",
    "reasoning": "medium"
  },
  "runtime": "../../runtime/current.json",
  "version": "0.1.0"
}
