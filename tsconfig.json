{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "disableSourceOfProjectReferenceRedirect": true,
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/**/*.ts",
    "services/**/*.ts",
    "tests/**/*.ts",
    "services/**/*.tsx",
    "runtime/**/*.ts",
    "apps/**/*.ts",
    "deploy/execution/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx"
  ],
  "exclude": ["services/access/generated", "services/connections/generated"],
  "references": [
    {
      "path": "./tsconfig.sdk.json"
    }
  ]
}
