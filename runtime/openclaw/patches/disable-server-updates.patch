-      manualIsCurrent = isCurrent;
-      params.onRefreshing(true);
-    }
-    try {
-      const response = await client
-        .request<UpdateRestartStatusResponse>(
-          "update.status",
-          refreshCheckout ? { refreshCheckout: true } : {},
-          { timeoutMs: 5_000 },
-        )
