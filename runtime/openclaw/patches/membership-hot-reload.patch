diff --git a/src/gateway/identity-policy.ts b/src/gateway/identity-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5fde277ca5fb61b16ccc8d7f4f2ece64c97bf4b5
--- /dev/null
+++ b/src/gateway/identity-policy.ts
@@ -0,0 +1,64 @@
+// Identity-local grants must not revoke unrelated authenticated sessions.
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { sha256Base64Url } from "../infra/crypto-digest.js";
+import type { ResolvedGatewayAuth } from "./auth.js";
+import type { OperatorScope } from "./operator-scopes.js";
+import { resolveSharedGatewaySessionGeneration } from "./server/ws-shared-generation.js";
+
+export function resolveIdentityScopeGrant(
+  identityScopes: Record<string, OperatorScope[]> | undefined,
+  identity: string,
+): OperatorScope[] {
+  const exact = identityScopes?.[identity];
+  if (exact !== undefined) {
+    return exact;
+  }
+  if (!identity.includes("@")) {
+    return [];
+  }
+  const normalized = identity.toLowerCase();
+  return (
+    Object.entries(identityScopes ?? {}).find(
+      ([key]) => key.includes("@") && key.toLowerCase() === normalized,
+    )?.[1] ?? []
+  );
+}
+
+export function resolveGatewayIdentityPolicyGeneration(params: {
+  config: OpenClawConfig;
+  auth: ResolvedGatewayAuth;
+  identity: string;
+  method: "trusted-proxy" | "tailscale";
+  role?: string;
+}): string | undefined {
+  const { config, auth, identity, method } = params;
+  if (!identity) {
+    return undefined;
+  }
+  let shared: string | undefined;
+  if (method === "trusted-proxy") {
+    const allowUsers = auth.trustedProxy?.allowUsers;
+    if (auth.mode !== "trusted-proxy" || (allowUsers?.length && !allowUsers.includes(identity))) {
+      return undefined;
+    }
+    shared = resolveSharedGatewaySessionGeneration(
+      {
+        ...auth,
+        trustedProxy: auth.trustedProxy
+          ? { ...auth.trustedProxy, allowUsers: undefined }
+          : undefined,
+      },
+      config.gateway?.trustedProxies,
+    );
+  } else if (!auth.allowTailscale) {
+    return undefined;
+  }
+  const role = params.role ?? "operator";
+  const scopes =
+    role === "operator"
+      ? resolveIdentityScopeGrant(config.gateway?.auth?.identityScopes, identity)
+      : [];
+  return sha256Base64Url(
+    JSON.stringify({ method, shared, identity, role, scopes: [...new Set(scopes)].toSorted() }),
+  );
+}
