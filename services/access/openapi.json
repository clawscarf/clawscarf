{
  "openapi": "3.0.3",
  "info": {
    "title": "ClawScarf access",
    "version": "0.1.0"
  },
  "paths": {
    "/_clawscarf/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/_clawscarf/login": {
      "get": {
        "operationId": "startLogin",
        "responses": {
          "302": {
            "description": "Redirect"
          },
          "default": {
            "description": "Failure. Browser requests accepting text/html receive a sign-in error page; API clients receive Problem Details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "returnTo",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "setup",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "description": "Private, one-use first-administrator setup token."
          },
          {
            "in": "query",
            "name": "invitation",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "description": "Private, one-use member invitation token."
          }
        ],
        "security": []
      }
    },
    "/_clawscarf/callback": {
      "get": {
        "operationId": "completeLogin",
        "responses": {
          "302": {
            "description": "Redirect"
          },
          "default": {
            "description": "Failure. Browser requests accepting text/html receive a sign-in error page; API clients receive Problem Details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "error",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "error_description",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "iss",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": []
      }
    },
    "/_clawscarf/session": {
      "get": {
        "operationId": "session",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user",
                    "csrfToken",
                    "enrollmentEnabled",
                    "links"
                  ],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    },
                    "csrfToken": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "enrollmentEnabled": {
                      "type": "boolean"
                    },
                    "links": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "$ref": "#/components/schemas/NavigationLink"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "browserSession": []
          }
        ]
      }
    },
    "/_clawscarf/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["redirect"],
                  "properties": {
                    "redirect": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "browserSession": [],
            "csrfToken": []
          }
        ]
      }
    },
    "/_clawscarf/people": {
      "get": {
        "operationId": "listPeople",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "people": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Person"
                      }
                    },
                    "enrollment": {
                      "type": "string",
                      "enum": [
                        "ready",
                        "preparation_required",
                        "configuration_required"
                      ],
                      "description": "Current native enrollment configuration, observed without mutation after administrator authorization."
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Role"
                      }
                    }
                  },
                  "required": ["people", "enrollment", "roles"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "browserSession": []
          }
        ]
      },
      "post": {
        "operationId": "enrollPerson",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": ["subject", "email", "name"],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {
            "browserSession": [],
            "csrfToken": []
          }
        ]
      }
    },
    "/_clawscarf/people/{userId}": {
      "delete": {
        "operationId": "removePerson",
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "browserSession": [],
            "csrfToken": []
          }
        ]
      }
    },
    "/_clawscarf/team": {
      "post": {
        "operationId": "prepareTeam",
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "browserSession": [],
            "csrfToken": []
          }
        ]
      }
    },
    "/_clawscarf/people/{userId}/role": {
      "put": {
        "operationId": "setPersonRole",
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "browserSession": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "expectedRole": {
                    "type": "string",
                    "nullable": true
                  }
                },
                "required": ["role", "expectedRole"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/_clawscarf/invitations": {
      "get": {
        "operationId": "listInvitations",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invitations": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Invitation"
                      }
                    }
                  },
                  "required": ["invitations"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "browserSession": []
          }
        ]
      },
      "post": {
        "operationId": "createInvitation",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invitation": {
                      "$ref": "#/components/schemas/Invitation"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": ["invitation", "url"],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "browserSession": [],
            "csrfToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 320
                  }
                },
                "required": ["email"],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/_clawscarf/invitations/{invitationId}": {
      "delete": {
        "operationId": "revokeInvitation",
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "browserSession": [],
            "csrfToken": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "invitationId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code", "detail", "requestId"],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Client input failures return 400 (including malformed JSON), 413 for oversized bodies, or 415 for unsupported media types. Native request_rejected returns 409 for a confirmed rejection; outcome_unknown returns 503 when a mutation result cannot be established. Request IDs correlate service failures with sanitized diagnostics."
      },
      "User": {
        "type": "object",
        "required": ["id", "identity", "name", "email"],
        "properties": {
          "id": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "NavigationLink": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "href"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "href": {
            "type": "string",
            "pattern": "^/[^/].*$",
            "maxLength": 1024
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "administrator": {
            "type": "boolean"
          }
        },
        "required": ["id", "administrator"],
        "additionalProperties": false
      },
      "Person": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["id", "identity", "name", "email", "role"],
        "additionalProperties": false
      },
      "Invitation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "accepted", "revoked", "expired"]
          }
        },
        "required": ["id", "email", "expiresAt", "status"],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "clawscarf_session",
        "description": "Opaque HTTP-only browser session. Access validates current admission and session revocation; native administrator actions additionally verify current OpenClaw authority."
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token",
        "description": "Session-bound CSRF token from GET /_clawscarf/session. Browser mutations also require an exact matching Origin header."
      }
    }
  }
}
