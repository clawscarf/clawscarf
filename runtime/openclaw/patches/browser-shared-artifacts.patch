index 0000000000000000000000000000000000000000..dafebb813ea4912d7687d4140852821f7bc706c7
--- /dev/null
+++ b/extensions/browser/src/browser/pw-shared-artifacts.test.ts
@@ -0,0 +1,74 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../../../test/helpers/temp-dir.js";
+import { saveBrowserDownload } from "./pw-download-capture.js";
+import { createSharedBrowserArtifacts, readSharedBrowserDownload } from "./pw-shared-artifacts.js";
+
+const directories = useAutoCleanupTempDirTracker(afterEach);
+afterEach(() => vi.unstubAllEnvs());
+
+describe("shared Chromium download artifacts", () => {
+  it("saves exact bytes through native output handling and removes the consumed artifact", async () => {
+    const directory = directories.make("browser-artifacts-");
+    vi.stubEnv("OPENCLAW_BROWSER_SHARED_ARTIFACTS_DIR", directory);
+    const connection = await createSharedBrowserArtifacts();
+    expect(connection).toBeDefined();
+    const artifact = path.join(connection!, "download-id");
+    const bytes = Buffer.from([0, 255, 1, 2, 0, 128]);
+    await fs.writeFile(artifact, bytes);
+    const saveAs = vi.fn(async () => {
+      throw new Error("must not copy untrusted paths");
+    });
+    const outputRoot = directories.make("browser-output-");
+    const download = {
+      path: async () => artifact,
+      suggestedFilename: () => "../report.bin",
+      saveAs,
+    };
+    const saving = saveBrowserDownload(download, { outputRoot });
+    download.path = async () => (await saving).path;
+    const result = await saving;
+    expect(await fs.readFile(result.path)).toEqual(bytes);
+    expect(path.dirname(result.path)).toBe(outputRoot);
+    expect(saveAs).not.toHaveBeenCalled();
+    await expect(fs.stat(artifact)).rejects.toMatchObject({ code: "ENOENT" });
+  });
+
+  it("rejects traversal, symlinks, hardlinks and oversized browser artifacts", async () => {
+    const directory = directories.make("browser-artifacts-");
+    const privateDirectory = directories.make("browser-private-");
+    vi.stubEnv("OPENCLAW_BROWSER_SHARED_ARTIFACTS_DIR", directory);
+    const secret = path.join(privateDirectory, "secret");
+    await fs.writeFile(secret, "controller-private");
+    await fs.symlink(secret, path.join(directory, "symlink"));
+    await fs.link(secret, path.join(directory, "hardlink"));
+    await fs.symlink(privateDirectory, path.join(directory, "parent"));
+    const oversized = path.join(directory, "large");
+    await fs.writeFile(oversized, Buffer.alloc(10 * 1024 * 1024 + 1));
+    for (const file of [
+      secret,
+      path.join(directory, "symlink"),
+      path.join(directory, "hardlink"),
+      path.join(directory, "parent/secret"),
+      oversized,
+    ]) {
+      await expect(readSharedBrowserDownload(file)).rejects.toThrow();
+    }
+    expect(await fs.readFile(secret, "utf8")).toBe("controller-private");
+  });
+
+  it("fails visibly on invalid or unavailable shared mounts and leaves ordinary browsing unchanged", async () => {
+    vi.stubEnv("OPENCLAW_BROWSER_SHARED_ARTIFACTS_DIR", undefined);
+    expect(await createSharedBrowserArtifacts()).toBeUndefined();
+    for (const value of ["", ".", "/", "/missing/browser-artifacts"]) {
+      vi.stubEnv("OPENCLAW_BROWSER_SHARED_ARTIFACTS_DIR", value);
+      await expect(createSharedBrowserArtifacts()).rejects.toThrow();
+    }
+    const directory = directories.make("browser-artifacts-");
+    const alias = path.join(directory, "alias");
+    await fs.symlink(directory, alias);
+    vi.stubEnv("OPENCLAW_BROWSER_SHARED_ARTIFACTS_DIR", alias);
+    await expect(createSharedBrowserArtifacts()).rejects.toThrow();
+  });
+});
diff --git a/extensions/browser/src/browser/pw-shared-artifacts.ts b/extensions/browser/src/browser/pw-shared-artifacts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eabb15550909aaa414bd34bfd092827af9433649
--- /dev/null
+++ b/extensions/browser/src/browser/pw-shared-artifacts.ts
@@ -0,0 +1,45 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { root } from "openclaw/plugin-sdk/file-access-runtime";
+import { BROWSER_PROXY_MAX_FILE_BYTES } from "../browser-proxy-envelope.js";
+
+/** Operator-owned mount shared with a remote Chromium, never its profile or workspace. */
+export function sharedBrowserArtifactsRoot(): string | undefined {
+  const value = process.env.OPENCLAW_BROWSER_SHARED_ARTIFACTS_DIR;
+  if (value === undefined) {
+    return undefined;
+  }
+  if (!value || !path.isAbsolute(value) || path.resolve(value) === path.parse(value).root) {
+    throw new Error("Browser shared artifacts directory must be an absolute non-root path");
+  }
+  return path.resolve(value);
+}
+
+export async function createSharedBrowserArtifacts(): Promise<string | undefined> {
+  const directory = sharedBrowserArtifactsRoot();
+  if (!directory) {
+    return undefined;
+  }
+  const stat = await fs.lstat(directory);
+  if (!stat.isDirectory() || stat.isSymbolicLink()) {
+    throw new Error("Browser shared artifacts directory must be a real directory");
+  }
+  return await fs.mkdtemp(path.join(directory, "connection-"));
+}
+
+/** Read browser-written bytes without following links into the controller's filesystem. */
+export async function readSharedBrowserDownload(artifactPath: string): Promise<Buffer> {
+  const directory = sharedBrowserArtifactsRoot();
+  if (!directory) {
+    throw new Error("Browser shared artifacts directory is not configured");
+  }
+  const artifacts = await root(directory);
+  const result = await artifacts.read(path.relative(directory, artifactPath), {
+    symlinks: "reject",
+    hardlinks: "reject",
+    nonBlockingRead: true,
+    maxBytes: BROWSER_PROXY_MAX_FILE_BYTES,
+  });
+  await artifacts.remove(path.relative(directory, artifactPath));
+  return result.buffer;
+}
