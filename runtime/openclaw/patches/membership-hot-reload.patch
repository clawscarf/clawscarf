+import { describe, expect, it } from "vitest";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { ResolvedGatewayAuth } from "./auth.js";
+import {
+  resolveGatewayIdentityPolicyGeneration,
+  resolveIdentityScopeGrant,
+} from "./identity-policy.js";
+
+const auth: ResolvedGatewayAuth = {
+  mode: "trusted-proxy",
+  allowTailscale: false,
+  trustedProxy: { userHeader: "x-user", allowUsers: ["alice", "bob"] },
+};
+const config: OpenClawConfig = {
+  gateway: {
+    auth: { identityScopes: { alice: ["operator.admin"], bob: ["operator.read"] } },
+    trustedProxies: ["127.0.0.1"],
+  },
+};
+const generation = (cfg = config, resolvedAuth = auth, identity = "alice", role = "operator") =>
+  resolveGatewayIdentityPolicyGeneration({
+    config: cfg,
+    auth: resolvedAuth,
+    identity,
+    role,
+    method: "trusted-proxy",
+  });
+
+describe("identity-local gateway policy generation", () => {
+  it("preserves Alice when Bob's membership or grants change", () => {
+    expect(
+      generation(config, {
+        ...auth,
+        trustedProxy: { ...auth.trustedProxy!, allowUsers: ["alice"] },
+      }),
+    ).toBe(generation());
+    expect(
+      generation({
+        gateway: {
+          ...config.gateway,
+          auth: { identityScopes: { alice: ["operator.admin"], bob: ["operator.admin"] } },
+        },
+      }),
+    ).toBe(generation());
+  });
+  it("invalidates the affected identity and shared trust changes", () => {
+    expect(
+      generation(config, { ...auth, trustedProxy: { ...auth.trustedProxy!, allowUsers: ["bob"] } }),
+    ).toBeUndefined();
+    expect(
+      generation({
+        gateway: { ...config.gateway, auth: { identityScopes: { alice: ["operator.read"] } } },
+      }),
+    ).not.toBe(generation());
+    expect(
+      generation(config, {
+        ...auth,
+        trustedProxy: { ...auth.trustedProxy!, userHeader: "new-user" },
+      }),
+    ).not.toBe(generation());
+    expect(generation({ gateway: { ...config.gateway, trustedProxies: ["10.0.0.1"] } })).not.toBe(
+      generation(),
+    );
+  });
+  it("uses exact identity first, with an email-only case-insensitive fallback", () => {
+    const grants = {
+      "Alice@example.test": ["operator.read"],
+      "alice@example.test": ["operator.admin"],
+      ALICE: ["operator.admin"],
+    } satisfies Record<string, ("operator.read" | "operator.admin")[]>;
+    expect(resolveIdentityScopeGrant(grants, "alice@example.test")).toEqual(["operator.admin"]);
+    expect(resolveIdentityScopeGrant(grants, "ALICE@example.test")).toEqual(["operator.read"]);
+    expect(resolveIdentityScopeGrant(grants, "alice")).toEqual([]);
+  });
+  it("normalizes grants and excludes operator identity grants from node policy", () => {
+    const reordered: OpenClawConfig = {
+      gateway: {
+        ...config.gateway,
+        auth: { identityScopes: { alice: ["operator.admin", "operator.admin"] } },
+      },
+    };
+    expect(generation(reordered)).toBe(generation());
+    expect(generation({ gateway: { ...config.gateway, auth: {} } }, auth, "alice", "node")).toBe(
+      generation(config, auth, "alice", "node"),
+    );
+  });
+  it("keeps Tailscale independent of bearer rotation but revokes when disabled", () => {
+    const params = { config, identity: "alice", method: "tailscale" as const };
+    expect(
+      resolveGatewayIdentityPolicyGeneration({
+        ...params,
+        auth: { mode: "token", token: "first", allowTailscale: true },
+      }),
+    ).toBe(
+      resolveGatewayIdentityPolicyGeneration({
+        ...params,
+        auth: { mode: "token", token: "second", allowTailscale: true },
+      }),
+    );
+    expect(resolveGatewayIdentityPolicyGeneration({ ...params, auth })).toBeUndefined();
+  });
