new file mode 100644
index 0000000000000000000000000000000000000000..8d62d56bbb72849dc8d4fdcc4ea9093d78f35d38
--- /dev/null
+++ b/src/infra/github-policy.ts
@@ -0,0 +1,15 @@
+import { isTruthyEnvValue } from "./env.js";
+
+export const GITHUB_INTEGRATION_DISABLED_MESSAGE =
+  "Built-in GitHub integration is disabled by this installation (OPENCLAW_NO_GITHUB=1).";
+
+/** Distribution policy for native integration; ordinary Git and gh commands remain available. */
+export function isGitHubIntegrationEnabled(): boolean {
+  return !isTruthyEnvValue(process.env.OPENCLAW_NO_GITHUB);
+}
+
+export function assertGitHubIntegrationEnabled(): void {
+  if (!isGitHubIntegrationEnabled()) {
+    throw new Error(GITHUB_INTEGRATION_DISABLED_MESSAGE);
+  }
+}
