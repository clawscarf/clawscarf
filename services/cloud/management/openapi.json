            }
          }
        }
      }
    },
    "/_clawscarf/cloud/{id}/checkouts": {
      "post": {
        "operationId": "createCloudCheckout",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "orderId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "creating",
                        "checkout_ready",
                        "payment_pending",
                        "paid",
                        "fulfilled",
                        "expired",
                        "failed",
                        "uncertain"
                      ]
                    },
                    "checkoutUrl": {
                      "type": ["string", "null"]
                    },
                    "expiresAt": {
                      "type": ["string", "null"],
                      "format": "date-time"
                    }
                  },
                  "required": ["orderId", "status", "checkoutUrl", "expiresAt"]
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "offerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "returnPath": {
                    "type": "string",
                    "pattern": "^/(?!/)",
                    "maxLength": 2048
                  }
                },
                "required": ["requestId", "offerId", "quantity", "returnPath"]
              }
            }
          }
        }
      }
    },
    "/_clawscarf/cloud/{id}/orders": {
      "get": {
        "operationId": "listCloudOrders",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "orders": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BillingOrder"
                      }
                    },
                    "nextCursor": {
                      "type": ["string", "null"],
                      "format": "uuid"
                    }
                  },
                  "required": ["orders", "nextCursor"]
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/_clawscarf/cloud/{id}/orders/{orderId}": {
      "get": {
        "operationId": "getCloudOrder",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingOrder"
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/_clawscarf/cloud/{id}/portal": {
      "post": {
        "operationId": "createCloudPortal",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "x-csrf-token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": ["url"]
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "returnPath": {
                    "type": "string",
                    "pattern": "^/(?!/)",
                    "maxLength": 2048
                  }
                },
                "required": ["requestId", "returnPath"]
              }
            }
          }
        }
      }
    },
    "/_clawscarf/cloud/capabilities": {
      "get": {
        "operationId": "getCloudCapabilities",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ai": {
                      "type": "boolean"
                    },
                    "connections": {
                      "type": "boolean"
                    }
                  },
                  "required": ["ai", "connections"]
                }
              }
            }
          },
          "default": {
            "description": "Failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "code", "requestId"]
      },
      "BillingAllowances": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "connections": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "unit": {
                "type": "string",
                "enum": ["executions"]
              },
              "state": {
                "type": "string",
                "enum": [
                  "disabled",
                  "pending",
                  "available",
                  "exhausted",
                  "suspended",
                  "unavailable"
                ]
              },
              "freeRemaining": {
                "type": "integer",
                "minimum": 0
              },
              "paidRemaining": {
                "type": "integer",
                "minimum": 0
              },
              "available": {
                "type": "integer",
                "minimum": 0
              },
              "resetsAt": {
                "type": ["string", "null"],
                "format": "date-time"
              }
            },
            "required": [
              "unit",
              "state",
              "freeRemaining",
              "paidRemaining",
              "available",
              "resetsAt"
            ]
          },
          "ai": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "unit": {
                "type": "string",
                "enum": ["usd_micros"]
              },
              "currency": {
                "type": "string",
                "enum": ["usd"]
              },
              "state": {
                "type": "string",
                "enum": [
                  "disabled",
                  "pending",
                  "available",
                  "exhausted",
                  "suspended",
                  "unavailable"
                ]
              },
              "freeRemaining": {
                "type": "integer",
                "minimum": 0
              },
              "paidRemaining": {
                "type": "integer",
                "minimum": 0
              },
              "available": {
                "type": "integer",
                "minimum": 0
              },
              "usageAsOf": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "overrun": {
                "type": "integer",
                "minimum": 0,
                "description": "Retail USD micros used beyond purchased credit; deducted from the next top-up."
              }
            },
            "required": [
              "unit",
              "currency",
              "state",
              "freeRemaining",
              "paidRemaining",
              "available",
              "usageAsOf",
              "overrun"
            ]
          },
          "purchasingAvailable": {
            "type": "boolean"
          }
        },
        "required": ["connections", "ai", "purchasingAvailable"]
      },
      "BillingOffer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "service": {
            "type": "string",
            "enum": ["connections", "ai"]
          },
          "currency": {
            "type": "string",
            "enum": ["usd"]
          },
          "priceMinor": {
            "type": "integer",
            "minimum": 0
          },
          "amount": {
            "type": "integer",
            "minimum": 0
          },
          "maxQuantity": {
            "type": "integer",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "enum": ["usd_micros", "executions"]
          },
          "expires": {
            "type": "boolean",
            "const": false
          },
          "scope": {
            "type": "string",
            "enum": ["account"]
          },
          "purchaseType": {
            "type": "string",
            "enum": ["one_time"]
          },
          "taxBehavior": {
            "type": "string",
            "enum": ["exclusive"]
          }
        },
        "required": [
          "id",
          "title",
          "service",
          "currency",
          "priceMinor",
          "amount",
          "maxQuantity",
          "unit",
          "expires",
          "scope",
          "purchaseType",
          "taxBehavior"
        ]
      },
      "BillingOrder": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "installationId": {
            "type": "string",
            "format": "uuid"
          },
          "service": {
            "type": "string",
            "enum": ["connections", "ai"]
          },
          "offerId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "enum": ["usd"]
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 0
          },
          "grantAmount": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "creating",
              "checkout_ready",
              "payment_pending",
              "paid",
              "fulfilled",
              "expired",
              "failed",
              "uncertain"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "refundedMinor": {
            "type": "integer",
            "minimum": 0
          },
          "disputedMinor": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "installationId",
          "service",
          "offerId",
          "quantity",
          "currency",
          "amountMinor",
          "grantAmount",
          "status",
          "createdAt",
          "refundedMinor",
          "disputedMinor"
        ]
      },
      "AiModel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Canonical model ID used by installations, independent of the upstream provider route.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "name": {
            "type": "string"
          },
          "protocols": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["responses", "chat/completions"]
            }
          },
          "contextTokens": {
            "type": "integer",
            "minimum": 0
          },
          "maxOutputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "inputMicrosPerMillion": {
            "type": "integer",
            "minimum": 0
          },
          "outputMicrosPerMillion": {
            "type": "integer",
            "minimum": 0
          },
          "rateVersion": {
            "type": "string"
          },
          "supportsTemperature": {
            "type": "boolean",
            "description": "Whether this route accepts the temperature parameter."
          },
          "reasoningEfforts": {
            "type": "array",
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "none",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "description": "Accepted reasoning efforts. Omit none for models that require reasoning; an empty array means no reasoning support."
          },
          "replyBudgetTokens": {
            "type": "integer",
            "minimum": 1,
            "description": "Cloud request output ceiling and installation starting reply budget, including reasoning tokens."
          }
        },
        "required": [
          "id",
          "name",
          "protocols",
          "contextTokens",
          "maxOutputTokens",
          "inputMicrosPerMillion",
          "outputMicrosPerMillion",
          "rateVersion",
          "supportsTemperature",
