# Private gateway-only values. Never copy this file into OpenClaw.
# Database belongs to LiteLLM, separate from Access/Connections tables.
DATABASE_URL=postgresql://litellm:replace@host.docker.internal:5432/clawscarf_models
LITELLM_MASTER_KEY=sk-replace-with-random-administrator-key
LITELLM_SALT_KEY=replace-with-stable-random-encryption-key
OPENROUTER_API_KEY=replace-with-provider-key
