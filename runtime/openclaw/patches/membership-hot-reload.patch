diff --git a/src/gateway/server/ws-identity-policy.ts b/src/gateway/server/ws-identity-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1a3858f85b867b29faa80ac210d709e144a5118d
--- /dev/null
+++ b/src/gateway/server/ws-identity-policy.ts
@@ -0,0 +1,60 @@
+import { getRuntimeConfig } from "../../config/io.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import type { ResolvedGatewayAuth } from "../auth.js";
+import { resolveGatewayIdentityPolicyGeneration } from "../identity-policy.js";
+import { getSharedGatewaySessionGenerationReaderState } from "../server-shared-auth-generation.js";
+import { invalidateGatewayPolicyClient } from "./ws-policy-close.js";
+import { resolveSharedGatewaySessionGeneration } from "./ws-shared-generation.js";
+import type { GatewayWsClient } from "./ws-types.js";
+
+export function isGatewayIdentityPolicyCurrent(
+  policy: NonNullable<GatewayWsClient["identityPolicy"]>,
+  config: OpenClawConfig,
+  auth: ResolvedGatewayAuth,
+): boolean {
+  return policy.generation === resolveGatewayIdentityPolicyGeneration({ ...policy, config, auth });
+}
+
+/** Called after committed publication, before shared-credential eviction. */
+export function reconcileGatewayIdentityPolicyClients(
+  clients: Iterable<
+    Pick<
+      GatewayWsClient,
+      | "identityPolicy"
+      | "usesSharedGatewayAuth"
+      | "sharedGatewaySessionGeneration"
+      | "invalidated"
+      | "invalidatedReason"
+    > & { socket: Pick<GatewayWsClient["socket"], "close"> }
+  >,
+  config: OpenClawConfig,
+  auth: ResolvedGatewayAuth,
+): void {
+  for (const client of clients) {
+    if (!client.identityPolicy || client.invalidated) continue;
+    if (!isGatewayIdentityPolicyCurrent(client.identityPolicy, config, auth)) {
+      invalidateGatewayPolicyClient(client, {
+        reason: "identity-policy-changed",
+        code: 4001,
+        message: "identity policy changed",
+      });
+    } else if (client.usesSharedGatewayAuth) {
+      // Keep credential/token generations strict; only this already authenticated
+      // socket can survive another identity's membership change.
+      client.sharedGatewaySessionGeneration = resolveSharedGatewaySessionGeneration(
+        auth,
+        config.gateway?.trustedProxies,
+      );
+    }
+  }
+}
+
+/** The shared-auth owner publishes policy only after the runtime commit succeeds. */
+export function readCommittedGatewayIdentityPolicy(
+  readGeneration: (() => string | undefined) | undefined,
+  getResolvedAuth: () => ResolvedGatewayAuth,
+): { config: OpenClawConfig; auth: ResolvedGatewayAuth } {
+  const committed =
+    readGeneration && getSharedGatewaySessionGenerationReaderState(readGeneration)?.identityPolicy;
+  return committed ?? { config: getRuntimeConfig(), auth: getResolvedAuth() };
+}
