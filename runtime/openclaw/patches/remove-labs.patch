-    return parentPath;
-  }
-  if (isRecord(parent) && Object.hasOwn(parent, key)) {
-    return feature.configPath;
-  }
-  return null;
-}
-
-export function resolveLabFeatureState(
-  config: Record<string, unknown> | null,
-  feature: LabFeature,
