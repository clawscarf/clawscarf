diff --git a/test/scripts/prune-docker-skills.test.ts b/test/scripts/prune-docker-skills.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b302603f1a504ad052446f092d4e6ff7df4c9672
--- /dev/null
+++ b/test/scripts/prune-docker-skills.test.ts
@@ -0,0 +1,178 @@
+import fs from "node:fs";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { pruneDockerSkills } from "../../scripts/prune-docker-skills.mjs";
+import { createScriptTestHarness } from "./test-helpers.js";
+
+const { createTempDir } = createScriptTestHarness();
+
+function write(root: string, relative: string, content = "fixture\n"): string {
+  const file = path.join(root, relative);
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  fs.writeFileSync(file, content);
+  return file;
+}
+
+describe("pruneDockerSkills", () => {
+  it.each([undefined, "", " \n "])("preserves the upstream default for %j", (selection) => {
+    const root = createTempDir("openclaw-docker-skills-");
+    const file = write(root, "skills/weather/SKILL.md");
+    expect(pruneDockerSkills({ cwd: root, env: { OPENCLAW_DOCKER_SKILLS: selection } })).toEqual(
+      [],
+    );
+    expect(fs.readFileSync(file, "utf8")).toBe("fixture\n");
+  });
+
+  it("prunes all packaged copies while preserving selected content, collection roots and user files", () => {
+    const root = createTempDir("openclaw-docker-skills-");
+    const removed = ["skills/weather", "extensions/browser/skills/obsolete"];
+    const kept = ["skills/skill-creator/SKILL.md", "skills/skill-creator/scripts/helper.py"];
+    for (const output of ["extensions", "dist/extensions", "dist-runtime/extensions"]) {
+      removed.push(`${output}/chat/skills/chat`);
+      kept.push(`${output}/browser/skills/browser-automation/SKILL.md`);
+      kept.push(`${output}/lobster/SKILL.md`);
+      kept.push(`${output}/chat/openclaw.plugin.json`);
+    }
+    kept.push("workspace/skills/custom/SKILL.md", ".openclaw/skills/custom/SKILL.md");
+    for (const directory of removed) {
+      write(root, `${directory}/SKILL.md`);
+      write(root, `${directory}/references/detail.md`);
+    }
+    for (const file of kept) {
+      write(
+        root,
+        file,
+        file.endsWith("openclaw.plugin.json") ? '{"skills":["./skills"]}' : "fixture\n",
+      );
+    }
+    expect(
+      pruneDockerSkills({
+        cwd: root,
+        env: { OPENCLAW_DOCKER_SKILLS: "skill-creator, browser-automation\nskill-creator" },
+      }),
+    ).toEqual(removed.sort());
+    for (const directory of removed) {
+      expect(fs.existsSync(path.join(root, directory))).toBe(false);
+    }
+    for (const file of kept) {
+      const contents = fs.readFileSync(path.join(root, file), "utf8");
+      if (file.endsWith("openclaw.plugin.json")) {
+        expect(JSON.parse(contents)).toEqual({ skills: ["./skills"] });
+        expect(fs.statSync(path.join(root, path.dirname(file), "skills")).isDirectory()).toBe(true);
+      } else {
+        expect(contents).toBe("fixture\n");
+      }
+    }
+    expect(fs.statSync(path.join(root, "dist/extensions/chat/skills")).isDirectory()).toBe(true);
+  });
+
+  it("allows an explicitly empty inventory", () => {
+    const root = createTempDir("openclaw-docker-skills-");
+    write(root, "skills/weather/SKILL.md");
+    expect(pruneDockerSkills({ cwd: root, env: { OPENCLAW_DOCKER_SKILLS: "-" } })).toEqual([
+      "skills/weather",
+    ]);
+  });
+
+  it("ignores documentation symlinks alongside plugins and skill directories", () => {
+    const root = createTempDir("openclaw-docker-skills-");
+    write(root, "skills/weather/SKILL.md");
+    write(root, "extensions/browser/skills/browser-automation/SKILL.md");
+    for (const directory of ["extensions", "skills", "extensions/browser/skills"]) {
+      write(root, `${directory}/AGENTS.md`, "Documentation\n");
+      fs.symlinkSync("AGENTS.md", path.join(root, directory, "CLAUDE.md"));
+    }
+    expect(pruneDockerSkills({ cwd: root, env: { OPENCLAW_DOCKER_SKILLS: "-" } })).toEqual([
+      "extensions/browser/skills/browser-automation",
+      "skills/weather",
+    ]);
+    for (const directory of ["extensions", "skills", "extensions/browser/skills"]) {
+      expect(fs.readlinkSync(path.join(root, directory, "CLAUDE.md"))).toBe("AGENTS.md");
+      expect(fs.readFileSync(path.join(root, directory, "AGENTS.md"), "utf8")).toBe(
+        "Documentation\n",
+      );
+    }
+  });
+
+  it("uses the configured bundled source directory without changing packaged output roots", () => {
+    const root = createTempDir("openclaw-docker-skills-");
+    write(root, "bundled/plugins/browser/skills/browser-automation/SKILL.md");
+    write(root, "bundled/plugins/chat/skills/chat/SKILL.md");
+    write(root, "dist/extensions/chat/skills/chat/SKILL.md");
+    expect(
+      pruneDockerSkills({
+        cwd: root,
+        env: {
+          OPENCLAW_DOCKER_SKILLS: "browser-automation",
+          OPENCLAW_BUNDLED_PLUGIN_DIR: "bundled/plugins",
+        },
+      }),
+    ).toEqual(["bundled/plugins/chat/skills/chat", "dist/extensions/chat/skills/chat"]);
+    expect(
+      fs.existsSync(path.join(root, "bundled/plugins/browser/skills/browser-automation/SKILL.md")),
+    ).toBe(true);
+  });
+
+  it("refuses a configured source directory outside the build root", () => {
+    const root = createTempDir("openclaw-docker-skills-");
+    const file = write(root, "skills/weather/SKILL.md");
+    expect(() =>
+      pruneDockerSkills({
+        cwd: root,
+        env: { OPENCLAW_DOCKER_SKILLS: "-", OPENCLAW_BUNDLED_PLUGIN_DIR: "../external" },
