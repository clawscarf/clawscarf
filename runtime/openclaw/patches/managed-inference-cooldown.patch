+  it.each([false, true])(
+    "retries the managed ClawScarf route after funding (old cached cooldown: %s)",
+    async (cachedCooldown) => {
+      await withAgentWorkspace(async ({ agentDir, workspaceDir }) => {
+        saveAuthProfileStore({ version: 1, profiles: {}, usageStats: {} }, agentDir);
+        const params = {
+          sessionId: "session:test",
+          sessionKey: "agent:test:clawscarf-billing",
+          workspaceDir,
+          agentDir,
+          config: makeConfig({ provider: "clawscarf" }),
+          prompt: "hello",
+          provider: "clawscarf",
+          model: "mock-1",
+          authProfileIdSource: "auto" as const,
+          timeoutMs: 5_000,
+        };
+        runEmbeddedAttemptMock.mockResolvedValueOnce(
+          makeAttempt({
+            terminal: {
+              kind: "failed",
+              source: "prompt",
+              error: new Error("insufficient credits"),
+            },
+          }),
+        );
+        await expect(
+          runEmbeddedAgentInline({ ...params, runId: "run:clawscarf-unfunded" }),
+        ).rejects.toThrow(/insufficient credits/);
+        expect(runEmbeddedAttemptMock).toHaveBeenCalledTimes(1);
+        const usageId = resolveInlineProviderApiKeyUsageId("clawscarf");
+        expect((await readUsageStats(agentDir))[usageId]).toBeUndefined();
+
+        if (cachedCooldown) {
+          saveAuthProfileStore(
+            {
+              version: 1,
+              profiles: {},
+              usageStats: {
+                [usageId]: {
+                  disabledUntil: Date.now() + 10 * 60_000,
+                  disabledReason: "billing",
+                },
+              },
+            },
+            agentDir,
+          );
+          expect((await readUsageStats(agentDir))[usageId]?.disabledReason).toBe("billing");
+        }
+        runEmbeddedAttemptMock.mockResolvedValueOnce(
+          makeAttempt({
+            assistantTexts: ["ok"],
+            lastAssistant: buildAssistant({
+              provider: "clawscarf",
+              stopReason: "stop",
+              content: [{ type: "text", text: "ok" }],
+            }),
+          }),
+        );
+        const result = await runEmbeddedAgentInline({ ...params, runId: "run:clawscarf-funded" });
+        expect(result.payloads?.[0]?.text).toBe("ok");
+        expect(runEmbeddedAttemptMock).toHaveBeenCalledTimes(2);
+        expect(sleepWithAbortMock).not.toHaveBeenCalled();
+      });
+    },
+  );
+
