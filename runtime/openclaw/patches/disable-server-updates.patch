-          if (mode !== "background" && isCurrent()) {
-            params.onError(error);
-          }
-          return null;
-        });
-      if (response && isCurrent()) {
-        params.onStatus(response);
-        return true;
-      }
-      return false;
-    } finally {
-      if (ownsRequest()) {
-        manualIsCurrent = null;
-        params.onRefreshing(false);
-      }
-    }
-  };
-}
