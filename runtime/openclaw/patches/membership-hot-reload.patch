+      expect(failure).toBeUndefined();
+      expect(state.sessionSharedGatewaySessionGeneration).toBe(nextGeneration);
+    } else if (scenario === "removal candidate rejected") {
+      expect(failure).toBeUndefined();
+      expect(state.sessionSharedGatewaySessionGeneration).toBe(sharedGeneration);
+    } else {
+      expect(failure).toEqual({ kind: "auth" });
+    }
+  });
+});
