new file mode 100644
index 0000000000000000000000000000000000000000..0df21e3a91baa9021c086e6b0b0158ec79b44639
--- /dev/null
+++ b/src/gateway/server.github-publication-startup.test.ts
@@ -0,0 +1,123 @@
+import { describe, expect, it, vi } from "vitest";
+import * as nativeGitHubIdentity from "../agents/github-read-identity.js";
+import * as githubProfiles from "../agents/github-tool-profile-cleanup.js";
+import { writeConfigFile } from "../config/config.js";
+import * as githubOAuth from "./github-oauth-lifecycle.js";
+import {
+  connectOk,
+  installGatewayTestHooks,
+  rpcReq,
+  startServerWithClient,
+} from "./test-helpers.js";
+
+installGatewayTestHooks();
+
+describe("disabled native GitHub integration", () => {
+  it("keeps local chat available without GitHub methods, credential probes or background lifecycles", async () => {
+    process.env.OPENCLAW_TEST_MINIMAL_GATEWAY = "0";
+    vi.stubEnv("OPENCLAW_NO_GITHUB", "1");
+    await writeConfigFile({
+      tools: { github: { profileId: "ghp_11111111111111111111111111111111", kind: "oauth" } },
+      gateway: { controlUi: { github: { token: "synthetic-unused-preview-token" } } },
+    });
+    // Prevent ambient credential access if startup regresses, then assert no probes occurred.
+    const nativeToken = vi
+      .spyOn(nativeGitHubIdentity, "readNativeGitHubToken")
+      .mockResolvedValue(undefined);
+    const cachedToken = vi
+      .spyOn(nativeGitHubIdentity, "readCachedNativeGitHubToken")
+      .mockResolvedValue(undefined);
+    const oauth = vi.spyOn(githubOAuth, "createGitHubOAuthLifecycle");
+    const cleanup = vi.spyOn(githubProfiles, "cleanupRetiredManagedGitHubProfiles");
+    try {
+      const { server, ws } = await startServerWithClient(undefined, { auth: { mode: "none" } });
+      try {
+        const hello = await connectOk(ws);
+        expect(hello).toMatchObject({
+          features: {
+            methods: expect.arrayContaining([
+              "sessions.create",
+              "chat.history",
+              "projects.register",
+              "node.list",
+            ]),
+          },
+        });
+        const sessionKey = "agent:main:dashboard:github-startup-proof";
+        const created = await rpcReq(ws, "sessions.create", {
+          key: sessionKey,
+          label: "Ordinary local chat",
+        });
+        expect(created.ok).toBe(true);
+
+        const history = await rpcReq(ws, "chat.history", { sessionKey });
+        expect(history.ok, history.error?.message).toBe(true);
+        const schema = await rpcReq(ws, "config.schema", {});
+        expect(schema.ok, schema.error?.message).toBe(true);
+        expect(schema.payload).not.toHaveProperty("schema.properties.tools.properties.github");
+        expect(schema.payload).not.toHaveProperty(["uiHints", "tools.github"]);
+        for (const path of ["tools.github", "agents.entries.main.tools.github"]) {
+          const lookup = await rpcReq(ws, "config.schema.lookup", { path });
+          expect(lookup).toMatchObject({
+            ok: false,
+            error: { message: "config schema path not found" },
+          });
+        }
+        for (const method of [
+          "users.github.status",
+          "users.github.authorize.start",
+          "users.github.authorize.poll",
+          "users.github.authorize.cancel",
+          "users.github.disconnect",
+          "tools.github.status",
+          "tools.github.configure",
+          "tools.github.authorize.start",
+          "tools.github.authorize.poll",
+          "tools.github.authorize.cancel",
+          "sessions.github.options",
+          "sessions.github.status",
+          "sessions.github.publish",
+          "sessions.github.confirm",
+          "controlUi.githubPreview",
+          "controlUi.sessionPullRequests.subscribe",
+          "controlUi.sessionPullRequests.checks",
+          "projects.searchRemote",
+          "projects.add",
+          "environments.create",
+          "sessions.dispatch",
+          "sessions.move",
+        ]) {
+          expect(hello).toMatchObject({
+            features: { methods: expect.not.arrayContaining([method]) },
+          });
+          const response = await rpcReq(ws, method, {});
+          expect(response).toMatchObject({
+            ok: false,
+            error: { message: expect.stringContaining("unknown method") },
+          });
+        }
+        const repository = await rpcReq(ws, "sessions.create", {
+          key: "agent:main:dashboard:disabled-repository",
+          repository: { url: "https://github.com/example/synthetic.git" },
+        });
+        expect(repository).toMatchObject({
+          ok: false,
+          error: { message: expect.stringContaining("OPENCLAW_NO_GITHUB") },
+        });
+        expect(nativeToken).not.toHaveBeenCalled();
+        expect(cachedToken).not.toHaveBeenCalled();
+        expect(oauth).not.toHaveBeenCalled();
+        expect(cleanup).not.toHaveBeenCalled();
+      } finally {
+        ws.close();
+        await server.close();
+      }
+    } finally {
+      nativeToken.mockRestore();
+      cachedToken.mockRestore();
+      oauth.mockRestore();
+      cleanup.mockRestore();
+      vi.unstubAllEnvs();
+    }
+  });
+});
