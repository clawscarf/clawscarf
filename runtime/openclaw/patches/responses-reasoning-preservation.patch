+import { describe, expect, it } from "vitest";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { castAgentMessage } from "./test-helpers/agent-message-fixtures.js";
+import { redactTranscriptMessage } from "./transcript-redact.js";
+
+const config: OpenClawConfig = { logging: {} };
+const CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES = `gAAAA${"synthetic-base64url-".repeat(75)}`;
+const DOTTED_RESPONSES_CIPHERTEXT = `${CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES}.${Buffer.from("synthetic-openrouter-replay-routing").toString("base64url")}`;
+
+describe("Responses reasoning transcript redaction", () => {
+  it.each(["openai", "openrouter", "litellm", "clawscarf"])(
+    "preserves dotted Responses ciphertext through transcript serialization for %s",
+    (provider) => {
+      const replayItem = {
+        id: "rs_synthetic",
+        type: "reasoning",
+        summary: [],
+        status: "completed",
+        encrypted_content: DOTTED_RESPONSES_CIPHERTEXT,
+      };
+      const signature = JSON.stringify(replayItem);
+      for (const api of ["openai-responses", "openclaw-openai-responses-transport"]) {
+        const msg = castAgentMessage({
+          role: "assistant",
+          api,
+          model: "test-model",
+          provider,
+          content: [
+            {
+              type: "thinking",
+              thinking: "secret sk-abcdef1234567890xyz",
+              thinkingSignature: JSON.stringify({
+                ...replayItem,
+                summary: [{ type: "summary_text", text: "secret sk-abcdef1234567890xyz" }],
+                content: [{ type: "reasoning_text", text: "secret sk-abcdef1234567890xyz" }],
+              }),
+            },
+            { type: "text", text: DOTTED_RESPONSES_CIPHERTEXT },
+          ],
+        });
+        const result = redactTranscriptMessage(msg, config);
+        expect(result).toMatchObject({ content: [{ thinkingSignature: signature }, {}] });
+        const serialized = JSON.stringify(result);
+        expect(serialized).not.toContain("sk-abcdef1234567890xyz");
+        expect(result).not.toMatchObject({
+          content: [{}, { text: DOTTED_RESPONSES_CIPHERTEXT }],
+        });
+        const reloaded = castAgentMessage(JSON.parse(serialized));
+        expect(redactTranscriptMessage(reloaded, config)).toMatchObject({
+          content: [{ thinkingSignature: signature }, {}],
+        });
+      }
+    },
+  );
+
+  it.each([
+    `${CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES}.`,
+    `.${CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES}`,
+    `${CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES}..suffix`,
+    `${CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES}.suffix.extra`,
+    `${CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES}.not a token`,
+    `${CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES}.suffix\n`,
+    `${CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES}.suffix=middle`,
+    `${CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES}.suffix…`,
+  ])("does not preserve malformed dotted Responses ciphertext %s", (encryptedContent) => {
+    const msg = castAgentMessage({
+      role: "assistant",
+      api: "openai-responses",
+      model: "test-model",
+      provider: "openrouter",
+      content: [
+        {
+          type: "thinking",
+          thinking: "visible",
+          thinkingSignature: JSON.stringify({
+            type: "reasoning",
+            encrypted_content: encryptedContent,
+            summary: [],
+          }),
+        },
+      ],
+    });
+    expect(JSON.stringify(redactTranscriptMessage(msg, config))).not.toContain(
+      CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES,
+    );
+  });
+
+  it.each(["custom-provider-api", "anthropic-messages", "openai-completions"])(
+    "keeps dotted payload redaction on %s unchanged",
+    (api) => {
+      const msg = castAgentMessage({
+        role: "assistant",
+        api,
+        model: "test-model",
+        provider: "custom-provider",
+        content: [
+          {
+            type: "thinking",
+            thinking: "visible",
+            thinkingSignature: JSON.stringify({
+              type: "reasoning",
+              encrypted_content: DOTTED_RESPONSES_CIPHERTEXT,
+              summary: [],
+            }),
+          },
+        ],
+      });
+      expect(JSON.stringify(redactTranscriptMessage(msg, config))).not.toContain(
+        CIPHERTEXT_WITH_TOKEN_SHAPED_BYTES,
+      );
+    },
+  );
+});
