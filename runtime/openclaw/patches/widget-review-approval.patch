index 0000000000000000000000000000000000000000..8bd8519e9e81cf189d8f9b6755c12df147e6ca4f
--- /dev/null
+++ b/src/gateway/server-methods/board-review-approval.test.ts
@@ -0,0 +1,72 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { BoardSnapshot } from "../../../packages/gateway-protocol/src/index.js";
+import { resetPluginRuntimeStateForTest } from "../../plugins/runtime.js";
+import { createBoardHarness as createHarness } from "./board.test-support.js";
+
+const reviewWidgetApproval = vi.hoisted(() => vi.fn());
+const sessionKey = "agent:main:session";
+vi.mock("../../agents/exec-auto-reviewer.js", () => ({
+  createModelExecAutoReviewer: vi.fn(() => reviewWidgetApproval),
+}));
+vi.mock("../../config/sessions/session-accessor.entry.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../config/sessions/session-accessor.entry.js")>()),
+  loadSessionEntryReadOnly: vi.fn(),
+}));
+describe("board review approval", () => {
+  beforeEach(() => {
+    resetPluginRuntimeStateForTest();
+    reviewWidgetApproval.mockReset();
+    return () => resetPluginRuntimeStateForTest();
+  });
+  it.each(["granted", "rejected"] as const)(
+    "keeps a deferred Refresh review inactive until an operator chooses %s",
+    async (decision) => {
+      reviewWidgetApproval.mockResolvedValue({
+        decision: "ask",
+        risk: "unknown",
+        rationale: "Confirm that this widget may send refresh requests to the agent.",
+      });
+      const { invoke } = createHarness(undefined, undefined, undefined, {
+        getRuntimeConfig: () => ({
+          agents: { list: [{ id: "main" }] },
+          tools: { exec: { mode: "auto" } },
+        }),
+      });
+      await invoke("board.widget.put", {
+        sessionKey,
+        name: "mail-24h",
+        content: {
+          kind: "html",
+          html: "<button onclick=\"openclaw.prompt.send('Refresh the dashboard')\">Refresh</button>",
+        },
+        declared: { tools: ["prompt"] },
+      });
+      const before = await invoke("board.get", { sessionKey });
+      const pending = (before.mock.calls[0]![1] as BoardSnapshot).widgets[0]!;
+      expect(pending).toMatchObject({
+        grantState: "pending",
+        reviewReason: "Confirm that this widget may send refresh requests to the agent.",
+      });
+      expect(pending.frameUrl).toBeUndefined();
+      expect(pending.viewTicket).toBeUndefined();
+
+      const response = await invoke("board.widget.grant", {
+        sessionKey,
+        name: pending.name,
+        revision: pending.revision,
+        instanceId: pending.instanceId,
+        decision,
+      });
+      expect(response.mock.calls[0]?.[0]).toBe(true);
+      const after = await invoke("board.get", { sessionKey });
+      const widget = (after.mock.calls[0]![1] as BoardSnapshot).widgets[0]!;
+      expect(widget.grantState).toBe(decision);
+      expect(widget.reviewReason).toBeUndefined();
+      expect(Boolean(widget.frameUrl)).toBe(decision === "granted");
+      if (decision === "granted") {
+        const prompt = await invoke("board.prompt.authorize", { ticket: widget.viewTicket });
+        expect(prompt).toHaveBeenCalledWith(true, { confirmationRequired: false });
+      }
+    },
+  );
+});
