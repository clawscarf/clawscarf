diff --git a/scripts/prune-docker-skills.mjs b/scripts/prune-docker-skills.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b1d2e87c4afd8aadd0c583d519a7c2c68519e10e
--- /dev/null
+++ b/scripts/prune-docker-skills.mjs
@@ -0,0 +1,113 @@
+// Select the native skills shipped in an image, without modifying runtime/user skills.
+import fs from "node:fs";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import { assertRealOutputRoot } from "./lib/output-root-guard.mjs";
+
+function directoryEntries(directory) {
+  assertRealOutputRoot(directory);
+  try {
+    return fs.readdirSync(directory, { withFileTypes: true });
+  } catch (error) {
+    if (error?.code === "ENOENT") {
+      return [];
+    }
+    throw error;
+  }
+}
+
+function isDirectoryEntry(root, entry) {
+  const entryPath = path.join(root, entry.name);
+  // Documentation links such as CLAUDE.md -> AGENTS.md are not trees to prune.
+  // Inspect their type only; linked directories must still fail closed.
+  if (entry.isSymbolicLink() && fs.statSync(entryPath).isFile()) {
+    return false;
+  }
+  assertRealOutputRoot(entryPath);
+  return entry.isDirectory();
+}
+
+/**
+ * An unset/empty OPENCLAW_DOCKER_SKILLS preserves the upstream inventory.
+ * Otherwise it is an explicit comma/whitespace-separated list of skill directory
+ * names. A single "-" selects no skills. Plugin collection directories remain
+ * present because retained plugin manifests can still reference them.
+ */
+export function pruneDockerSkills(params = {}) {
+  const repoRoot = fs.realpathSync(params.cwd ?? process.cwd());
+  const env = params.env ?? process.env;
+  const selection = env.OPENCLAW_DOCKER_SKILLS;
+  if (selection === undefined || selection.trim() === "") {
+    return [];
+  }
+  const names = selection.trim() === "-" ? [] : selection.split(/[\s,]+/u).filter(Boolean);
+  if (names.length === 0 && selection.trim() !== "-") {
+    throw new Error("OPENCLAW_DOCKER_SKILLS must list skill names or '-' for no skills");
+  }
+  for (const name of names) {
+    if (!/^[a-z0-9][a-z0-9-]*$/u.test(name)) {
+      throw new Error(`Invalid OPENCLAW_DOCKER_SKILLS name: ${name}`);
+    }
+  }
+  const selected = new Set(names);
+  const bundledPluginDir = env.OPENCLAW_BUNDLED_PLUGIN_DIR ?? "extensions";
+  const pluginParts = bundledPluginDir.split(/[\\/]/u);
+  if (
+    path.isAbsolute(bundledPluginDir) ||
+    pluginParts.some((part) => !part || part === "." || part === "..")
+  ) {
+    throw new Error("OPENCLAW_BUNDLED_PLUGIN_DIR must be a directory within the build root");
+  }
+  let sourceRoot = repoRoot;
+  for (const part of pluginParts) {
+    sourceRoot = path.join(sourceRoot, part);
+    assertRealOutputRoot(sourceRoot);
+  }
+  const roots = [path.join(repoRoot, "skills")];
+  for (const output of ["", "dist", "dist-runtime"]) {
+    const outputRoot = path.join(repoRoot, output);
+    assertRealOutputRoot(outputRoot);
+    const extensionRoot = output === "" ? sourceRoot : path.join(outputRoot, "extensions");
+    for (const plugin of directoryEntries(extensionRoot)) {
+      const pluginRoot = path.join(extensionRoot, plugin.name);
+      if (isDirectoryEntry(extensionRoot, plugin)) {
+        roots.push(path.join(pluginRoot, "skills"));
+      }
+    }
+  }
+
+  // Discover and validate everything before deleting anything. In particular,
+  // a misspelled selection or symlinked build tree must leave the image intact.
+  const candidates = [];
+  for (const root of roots) {
+    for (const entry of directoryEntries(root)) {
+      const skillRoot = path.join(root, entry.name);
+      if (!isDirectoryEntry(root, entry)) {
+        continue;
+      }
+      const skillFile = path.join(skillRoot, "SKILL.md");
+      assertRealOutputRoot(skillFile);
+      if (fs.existsSync(skillFile)) {
+        candidates.push({ name: entry.name, directory: skillRoot });
+      }
+    }
+  }
+  const available = new Set(candidates.map((skill) => skill.name));
+  const unknown = [...selected].filter((name) => !available.has(name));
+  if (unknown.length > 0) {
+    throw new Error(`Unknown OPENCLAW_DOCKER_SKILLS names: ${unknown.join(", ")}`);
+  }
+
+  const removed = [];
+  for (const skill of candidates) {
+    if (!selected.has(skill.name)) {
+      fs.rmSync(skill.directory, { recursive: true });
+      removed.push(path.relative(repoRoot, skill.directory).replaceAll("\\", "/"));
+    }
+  }
+  return removed.sort();
+}
+
+if (import.meta.url === pathToFileURL(process.argv[1] ?? "").href) {
+  pruneDockerSkills();
+}
