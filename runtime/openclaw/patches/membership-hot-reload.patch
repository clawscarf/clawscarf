+        generation: identityGeneration,
+      },
+      issuedBootstrapProfile: null,
+      handoffBootstrapProfile: null,
+      trustedProxyAuthOk: true,
+      controlUiPairingKind: null,
+      skipLocalBackendSelfPairing: false,
+      rejectUnauthorized: unexpected,
+    };
+    const context = createContext(config, generation);
+    expect(resolveGatewayConnectPolicyFailure(context, state)).toBeUndefined();
+    const release = createDeferredCore();
+    const delayedFence = release.promise.then(() =>
+      resolveGatewayConnectPolicyFailure(context, state),
+    );
+    const next = structuredClone(config);
+    const nextAuthConfig = next.gateway?.auth;
+    if (!nextAuthConfig?.trustedProxy) throw new Error("fixture proxy config missing");
+    if (scenario === "other identity added") {
+      nextAuthConfig.trustedProxy.allowUsers = [ALICE, BOB, "carol@example.test"];
+    } else if (scenario === "own scopes reduced") {
+      nextAuthConfig.identityScopes = { [ALICE]: ["operator.admin"], [BOB]: ["operator.read"] };
