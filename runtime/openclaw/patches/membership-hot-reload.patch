+describe("Control UI plugin auth cookie identity-local revocation", () => {
+  const grants = [
+    {
+      pluginId: "example",
+      path: "/plugins/example",
+      match: "prefix" as const,
+      scopes: ["operator.read" as const],
+    },
+  ];
+  const proxyAuth: ResolvedGatewayAuth = {
+    mode: "trusted-proxy",
+    allowTailscale: false,
+    trustedProxy: { userHeader: "x-user", allowUsers: ["alice", "bob"] },
+  };
+  const config: OpenClawConfig = {
+    gateway: { auth: { identityScopes: { alice: ["operator.admin"], bob: ["operator.read"] } } },
+  };
+  function mint(identity?: string) {
+    const { res, setHeader } = makeMockHttpResponse();
+    setControlUiPluginAuthCookie(res, grants, {
+      generation: identity
+        ? resolveGatewayIdentityPolicyGeneration({
+            config,
+            auth: proxyAuth,
+            identity,
+            method: "trusted-proxy",
+          })
+        : "shared",
+      ...(identity ? { trustedProxyIdentity: identity } : {}),
+    });
+    const values = setHeader.mock.calls.at(-1)?.[1];
+    const cookie = Array.isArray(values) ? values[0] : values;
+    if (typeof cookie !== "string") {
+      throw new Error("expected cookie");
+    }
+    return cookie.split(";", 1)[0]!;
+  }
+  function resolve(cookie: string, cfg = config, auth = proxyAuth, shared = "shared") {
+    return resolveControlUiPluginAuthCookieGrants({ headers: { cookie } } as IncomingMessage, {
+      requestPath: "/plugins/example/session",
+      generation: shared,
+      resolveTrustedProxyIdentityGeneration: (identity) =>
+        resolveGatewayIdentityPolicyGeneration({
+          config: cfg,
+          auth,
+          identity,
+          method: "trusted-proxy",
+        }),
+    });
+  }
+  it("keeps Alice's existing plugin cookie across Bob's enrollment and scope changes", () => {
+    const cookie = mint("alice");
+    expect(
+      resolve(
+        cookie,
+        {
+          gateway: {
+            auth: { identityScopes: { alice: ["operator.admin"], bob: ["operator.admin"] } },
+          },
+        },
+        {
+          ...proxyAuth,
+          trustedProxy: { ...proxyAuth.trustedProxy!, allowUsers: ["alice", "bob", "charlie"] },
+        },
+        "new-shared",
+      ),
+    ).toEqual(grants);
+  });
+  it("revokes Alice's cookie when Alice is removed or her grants change", () => {
+    const cookie = mint("alice");
+    expect(
+      resolve(cookie, config, {
+        ...proxyAuth,
+        trustedProxy: { ...proxyAuth.trustedProxy!, allowUsers: ["bob"] },
+      }),
+    ).toEqual([]);
+    expect(
+      resolve(cookie, { gateway: { auth: { identityScopes: { alice: ["operator.read"] } } } }),
+    ).toEqual([]);
+    expect(resolve(cookie, config, { mode: "token", token: "new", allowTailscale: false })).toEqual(
+      [],
+    );
+  });
+  it("never trusts tampered identity before validating its signature", () => {
+    const cookie = mint("alice");
+    const [nameAndVersion, encoded, signature] = cookie.split(".");
+    const payload = JSON.parse(Buffer.from(encoded!, "base64url").toString("utf8"));
+    payload.trustedProxyIdentity = "bob";
+    const resolver = vi.fn(() => "whatever");
+    const tampered = `${nameAndVersion}.${Buffer.from(JSON.stringify(payload)).toString("base64url")}.${signature}`;
+    expect(
+      resolveControlUiPluginAuthCookieGrants({ headers: { cookie: tampered } } as IncomingMessage, {
+        requestPath: "/plugins/example",
+        generation: "shared",
+        resolveTrustedProxyIdentityGeneration: resolver,
+      }),
+    ).toEqual([]);
+    expect(resolver).not.toHaveBeenCalled();
+  });
+  it("preserves full shared-generation revocation for cookies without an attested identity", () => {
+    const cookie = mint();
+    expect(resolve(cookie)).toEqual(grants);
+    expect(resolve(cookie, config, proxyAuth, "rotated")).toEqual([]);
+  });
+});
