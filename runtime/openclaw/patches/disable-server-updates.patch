diff --git a/src/infra/self-update-policy.ts b/src/infra/self-update-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2a95d8ac0eada446eea4e61531ba110a3e662499
--- /dev/null
+++ b/src/infra/self-update-policy.ts
@@ -0,0 +1,14 @@
+import { isTruthyEnvValue } from "./env.js";
+
+export const SELF_UPDATE_DISABLED_MESSAGE =
+  "OpenClaw self-update is disabled by this installation (OPENCLAW_NO_SELF_UPDATE=1). Update the runtime through its distribution provider.";
+
+export function isSelfUpdateEnabled(): boolean {
+  return !isTruthyEnvValue(process.env.OPENCLAW_NO_SELF_UPDATE);
+}
+
+export function assertSelfUpdateEnabled(): void {
+  if (!isSelfUpdateEnabled()) {
+    throw new Error(SELF_UPDATE_DISABLED_MESSAGE);
+  }
+}
