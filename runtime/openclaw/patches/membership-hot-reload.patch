+describe("identity policy after awaited handshake work", () => {
+  it.each([
+    "other identity added",
+    "own identity removed",
+    "own scopes reduced",
+    "structural rotation pending",
+    "removal candidate rejected",
+  ] as const)("revalidates when %s", async (scenario) => {
