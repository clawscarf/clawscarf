{
  "name": "clawscarf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "clawscarf": "scripts/clawscarf.mjs"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.sdk.json && tsc -p tsconfig.build.json && node --import tsx scripts/build-operator.ts && node --import tsx scripts/build-companion.ts && pnpm connectors:plugin:build && pnpm access:plugin:build",
    "check": "pnpm format:check && pnpm codegen:check && pnpm typecheck && pnpm connectors:plugin:check && pnpm access:plugin:check && pnpm lint && pnpm architecture:check && pnpm docs:check && pnpm test",
    "typecheck": "tsc -b tsconfig.sdk.json && tsc --noEmit",
    "lint": "eslint ui apps scripts services tests runtime deploy/execution plugins/access/src plugins/connections/src plugins/connections/tests plugins/connections/scripts eslint.config.mjs .dependency-cruiser.cjs",
    "docs:check": "node --import tsx scripts/check-docs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test scripts/*.test.ts tests/access/*.test.ts tests/connections/*.test.ts tests/models/*.test.ts tests/packs/*.test.ts tests/runtime/*.test.ts tests/companion/*.test.ts tests/deployment/*.test.ts",
    "connectors:plugin:setup": "npm --prefix plugins/connections run setup",
    "connectors:plugin:check": "npm --prefix plugins/connections run check && npm --prefix plugins/connections test",
    "connectors:plugin:build": "npm --prefix plugins/connections run build",
    "test:connector-plugin": "npm --prefix plugins/connections run test:native",
    "access:generate": "openapi-ts -f scripts/access-api.config.ts",
    "access:start": "node --import tsx services/access/runtime/entry.ts",
    "access:migrate": "node --import tsx services/access/runtime/migrate.ts",
    "test:access": "node --import tsx --test tests/access/*.test.ts",
    "architecture:check": "depcruise scripts ui apps services runtime plugins/connections/src plugins/access/src --config .dependency-cruiser.cjs",
    "codegen:check": "node --import tsx scripts/check-generated.ts",
    "test:connections": "node --import tsx --test tests/connections/*.test.ts",
    "access:plugin:setup": "npm --prefix plugins/access ci --ignore-scripts",
    "access:plugin:build": "npm --prefix plugins/access run build",
    "access:plugin:check": "npm --prefix plugins/access run check && npm --prefix plugins/access run validate",
    "companion:start": "node --import tsx apps/companion/entry.ts",
    "clawscarf": "node scripts/clawscarf.mjs",
    "http:generate": "node --import tsx scripts/generate-http.ts",
    "cloud:generate": "openapi-ts -f scripts/cloud-api.config.ts",
    "connections:management:generate": "openapi-ts -f scripts/connection-management-api.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.13",
    "@types/pg": "8.23.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "github-slugger": "2.0.0",
    "jose": "6.2.12",
    "marked": "18.0.12",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "ws": "8.21.3"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "8.0.2",
    "@fastify/static": "9.0.0",
    "@openclaw/gateway-client": "2026.9.4",
    "@tanstack/react-query": "5.102.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "commander": "^15.0.0",
    "cookie": "2.0.1",
    "fastify": "5.12.3",
    "fastify-openapi-glue": "4.11.4",
    "fastify-plugin": "6.0.0",
    "httpxy": "0.5.5",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.42.0",
    "node-pg-migrate": "9.0.0",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "proper-lockfile": "4.1.2",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "undici": "8.10.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
