+import { afterEach, describe, expect, it, vi } from "vitest";
+import { assertGitHubIntegrationEnabled, isGitHubIntegrationEnabled } from "./github-policy.js";
+
+afterEach(() => vi.unstubAllEnvs());
+
+describe("native GitHub distribution policy", () => {
+  it.each([undefined, "", "0", "false"])("preserves the upstream default for %s", (value) => {
+    vi.stubEnv("OPENCLAW_NO_GITHUB", value);
+    expect(isGitHubIntegrationEnabled()).toBe(true);
+    expect(() => assertGitHubIntegrationEnabled()).not.toThrow();
+  });
+  it.each(["1", "true"])("disables native integration for %s", (value) => {
+    vi.stubEnv("OPENCLAW_NO_GITHUB", value);
+    expect(isGitHubIntegrationEnabled()).toBe(false);
+    expect(() => assertGitHubIntegrationEnabled()).toThrow("OPENCLAW_NO_GITHUB");
+  });
+});
