+              "skills.library.list": {
+                entries: [],
+                profileId: "alice",
+                multipleProfiles: true,
+                defaultTarget: "personal",
+                canManageWorkspace: true,
+                defaultSelectionLimit: 64,
+              },
+              "skills.search": { results: [] },
+            },
+          });
+          await page.goto(`${suite.server.baseUrl}plugins`);
+          await gateway.waitForRequest("plugins.list");
