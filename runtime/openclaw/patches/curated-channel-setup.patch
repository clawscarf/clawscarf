--- /dev/null
+++ b/src/commands/channel-setup/discovery.local.test.ts
@@ -0,0 +1,81 @@
+import fs from "node:fs";
+import path from "node:path";
+import { afterEach, expect, it } from "vitest";
+import { createTempDirTracker } from "../../../test/helpers/temp-dir.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import { resolveInstalledPluginIndexStorePath } from "../../plugins/installed-plugin-index-store-path.js";
+import { createPluginCache, withPluginCache } from "../../plugins/plugin-cache.js";
+import { clearPluginMetadataLifecycleCaches } from "../../plugins/plugin-metadata-lifecycle.js";
+import { closeOpenClawStateDatabaseByPath } from "../../state/openclaw-state-db-cache.js";
+import { resolveChannelSetupEntries } from "./discovery.js";
+
+const tempDirs = createTempDirTracker();
+afterEach(() => {
+  clearPluginMetadataLifecycleCaches();
+  for (const root of tempDirs.dirs) {
+    closeOpenClawStateDatabaseByPath(
+      resolveInstalledPluginIndexStorePath({ env: { OPENCLAW_STATE_DIR: root } }),
+    );
+  }
+  tempDirs.cleanup();
+});
+
+it("discovers unconfigured bundled and administrator-installed channels without executing their code", () => {
+  const root = tempDirs.make("openclaw-local-channel-setup-");
+  const bundledRoot = path.join(root, "bundled");
+  const installedRoot = path.join(root, "installed");
+  const env = {
+    HOME: root,
+    OPENCLAW_STATE_DIR: root,
+    OPENCLAW_BUNDLED_PLUGINS_DIR: bundledRoot,
+    OPENCLAW_TEST_TRUST_BUNDLED_PLUGINS_DIR: "1",
+  };
+  for (const [rootDir, pluginId, channelId] of [
+    [path.join(bundledRoot, "whatsapp"), "whatsapp", "whatsapp"],
+    [installedRoot, "team-plugin", "team-chat"],
+    [path.join(root, ".openclaw/extensions/signal-shadow"), "signal-shadow", "signal"],
+  ] as const) {
+    fs.mkdirSync(rootDir, { recursive: true });
+    fs.writeFileSync(
+      path.join(rootDir, "index.js"),
+      'throw new Error("must not execute during discovery");\n',
+    );
+    fs.writeFileSync(
+      path.join(rootDir, "openclaw.plugin.json"),
+      JSON.stringify({
+        id: pluginId,
+        channels: [channelId],
+        configSchema: { type: "object", properties: {} },
+      }),
+    );
+    fs.writeFileSync(
+      path.join(rootDir, "package.json"),
+      JSON.stringify({
+        name: `@example/${pluginId}`,
+        type: "module",
+        openclaw: {
+          extensions: ["./index.js"],
+          channel: { id: channelId, label: channelId, description: "Synthetic local channel" },
+        },
+      }),
+    );
+  }
+  const cfg: OpenClawConfig = {
+    marketplace: { enabled: false },
+    plugins: { allow: ["whatsapp", "team-plugin"], load: { paths: [installedRoot] } },
+  };
+  const result = withPluginCache(createPluginCache(), () =>
+    resolveChannelSetupEntries({
+      cfg,
+      installedPlugins: [],
+      workspaceDir: root,
+      env,
+    }),
+  );
+  expect(result.entries.map((entry) => entry.id)).toEqual(["whatsapp", "team-chat"]);
+  expect(result.entries.some((entry) => entry.id === "signal" || entry.id === "imessage")).toBe(
+    false,
+  );
+  expect(result.installedCatalogById.get("team-chat")?.pluginId).toBe("team-plugin");
+  expect(result.installableCatalogById.get("whatsapp")?.origin).toBe("bundled");
+});
