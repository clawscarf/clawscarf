+
+const ALICE = "alice@example.test";
+const BOB = "bob@example.test";
+
+describe("membership hot reload", () => {
+  let state: Awaited<ReturnType<typeof createOpenClawTestState>>;
+  let server: Awaited<ReturnType<typeof startGatewayServerCore>> | undefined;
+  let port: number;
+  const clients: WebSocket[] = [];
+  beforeEach(async () => {
+    state = await createOpenClawTestState({
+      label: "membership-hot-reload",
+      env: {
+        OPENCLAW_GATEWAY_TOKEN: undefined,
+        OPENCLAW_GATEWAY_PASSWORD: undefined,
+        OPENCLAW_TEST_MINIMAL_GATEWAY: "0",
+        OPENCLAW_SKIP_BROWSER_CONTROL_SERVER: "1",
+        OPENCLAW_SKIP_CANVAS_HOST: "1",
+        OPENCLAW_SKIP_CHANNELS: "1",
+        OPENCLAW_SKIP_CRON: "1",
+        OPENCLAW_SKIP_GMAIL_WATCHER: "1",
+        OPENCLAW_SKIP_PROVIDERS: "1",
+        OPENCLAW_DISABLE_BUNDLED_PLUGINS: "1",
+      },
+    });
+    port = await getFreePort();
+  });
+  afterEach(async () => {
+    await runQaGatewayFixture(
+      async () => {},
+      ...clients.splice(0).map((client) => () => client.close()),
+      async () => {
+        await server?.close();
+        server = undefined;
+      },
+      () => state.cleanup(),
+      () => resetLogger(),
+      () => clearPluginMetadataLifecycleCaches(),
+    );
+  });
+  async function connect(identity: string) {
+    const socket = new WebSocket(`ws://127.0.0.1:${port}`, {
+      headers: {
+        "x-openclaw-user": identity,
+        "x-forwarded-for": "192.0.2.10",
+        "x-forwarded-proto": "http",
+        "x-forwarded-host": `127.0.0.1:${port}`,
+      },
+    });
+    clients.push(socket);
+    const closed = createDeferredCore<void>();
+    const closeEvents: number[] = [];
+    const pending = new Map<string, ReturnType<typeof createDeferredCore<unknown>>>();
+    let sequence = 0;
+    socket.on("message", (data) => {
+      const parsed = z
+        .object({
+          type: z.literal("res"),
+          id: z.string(),
+          ok: z.boolean(),
+          payload: z.unknown().optional(),
+          error: z.object({ message: z.string() }).optional(),
+        })
+        .safeParse(JSON.parse(data.toString()));
+      if (!parsed.success) return;
+      const frame = parsed.data;
+      const request = pending.get(frame.id);
+      if (!request) return;
+      pending.delete(frame.id);
+      if (frame.ok) request.resolve(frame.payload);
+      else request.reject(new Error(frame.error?.message ?? "Gateway rejected request"));
+    });
+    socket.on("close", (code) => {
+      closeEvents.push(code);
+      closed.resolve();
+      for (const request of pending.values()) request.reject(new Error(`closed ${code}`));
