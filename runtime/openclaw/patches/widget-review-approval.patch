diff --git a/src/boards/board-store.review.test.ts b/src/boards/board-store.review.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c9e79771f26f3e2060e9f8a597c6f958689c05e2
--- /dev/null
+++ b/src/boards/board-store.review.test.ts
@@ -0,0 +1,132 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../test/helpers/temp-dir.js";
+import { closeOpenClawAgentDatabasesForTest } from "../state/openclaw-agent-db.js";
+import { closeOpenClawStateDatabaseForTest } from "../state/openclaw-state-db.js";
+import { createTestBoardStore } from "./board-store.test-support.js";
+
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+
+afterEach(() => {
+  closeOpenClawAgentDatabasesForTest();
+  closeOpenClawStateDatabaseForTest();
+});
+
+describe("board widget review persistence", () => {
+  const createStore = createTestBoardStore;
+  const boardSession = { sessionKey: "agent:main:board" };
+  it.each(["pending", "rejected"] as const)(
+    "retains a bounded %s review reason across reads and layout updates, then clears it on replacement",
+    async (decision) => {
+      const stateDir = tempDirs.make("openclaw-board-review-reason-");
+      const store = createStore({ stateDir });
+      const params = {
+        ...boardSession,
+        name: "refresh",
+        content: { kind: "html" as const, html: "<button>Refresh</button>" },
+        declared: { tools: ["prompt"] },
+      };
+      const first = await store.putWidget(params);
+      const reviewReason = "Review needed. ".repeat(50);
+      const reviewed = await store.grant(
+        boardSession,
+        "refresh",
+        decision,
+        1,
+        first.widgets[0]?.instanceId,
+        { reviewReason: `  ${reviewReason}  ` },
+      );
+      expect(reviewed.widgets[0]).toMatchObject({
+        grantState: decision,
+        reviewReason: reviewReason.trim().slice(0, 500).trimEnd(),
+      });
+      closeOpenClawAgentDatabasesForTest();
+      const reopened = createStore({ stateDir });
+      expect(await reopened.getSnapshot(boardSession)).toEqual(reviewed);
+      const resized = await reopened.applyOps(boardSession, [
+        { kind: "widget_resize", name: "refresh", sizeW: 8, sizeH: 5 },
+      ]);
+      expect(resized.widgets[0]?.reviewReason).toBe(reviewed.widgets[0]?.reviewReason);
+      expect(await reopened.getSnapshot(boardSession)).toEqual(resized);
+      const replaced = await reopened.putWidget({
+        ...params,
+        content: { kind: "html", html: "<button>Refresh now</button>" },
+      });
+      expect(replaced.widgets[0]).toMatchObject({ grantState: "pending", revision: 2 });
+      expect(replaced.widgets[0]).not.toHaveProperty("reviewReason");
+      expect(await reopened.getSnapshot(boardSession)).toEqual({
+        sessionKey: replaced.sessionKey,
+        revision: replaced.revision,
+        tabs: replaced.tabs,
+        widgets: replaced.widgets,
+      });
+    },
+  );
+
+  it.each(["granted", "rejected"] as const)(
+    "clears pending reviewer context after a manual %s decision",
+    async (decision) => {
+      const store = createStore();
+      const first = await store.putWidget({
+        ...boardSession,
+        name: "refresh",
+        content: { kind: "html", html: "<button>Refresh</button>" },
+        declared: { tools: ["prompt"] },
+      });
+      await store.grant(boardSession, "refresh", "pending", 1, first.widgets[0]?.instanceId, {
+        reviewReason: "Confirm that this widget may send messages to the agent.",
+      });
+      const resolved = await store.grant(
+        boardSession,
+        "refresh",
+        decision,
+        1,
+        first.widgets[0]?.instanceId,
+      );
+      expect(resolved.widgets[0]).toMatchObject({ grantState: decision });
+      expect(resolved.widgets[0]).not.toHaveProperty("reviewReason");
+      expect(await store.getSnapshot(boardSession)).toEqual(resolved);
+      await expect(
+        store.grant(boardSession, "refresh", "pending", 1, first.widgets[0]?.instanceId, {
+          reviewReason: "Late reviewer result.",
+        }),
+      ).rejects.toThrow("not pending");
+      expect(await store.getSnapshot(boardSession)).toEqual(resolved);
+    },
+  );
+
+  it("cannot attach review context to a stale widget or after caller authority is revoked", async () => {
+    const store = createStore();
+    const params = {
+      ...boardSession,
+      name: "refresh",
+      content: { kind: "html" as const, html: "<button>Refresh</button>" },
+      declared: { tools: ["prompt"] },
+    };
+    const first = await store.putWidget(params);
+    const replacement = await store.putWidget(params);
+    const before = await store.getSnapshot(boardSession);
+    await expect(
+      store.grant(boardSession, "refresh", "pending", 1, first.widgets[0]?.instanceId, {
+        reviewReason: "Stale review.",
+      }),
+    ).rejects.toThrow("revision changed");
+    await expect(
+      store.grant(boardSession, "refresh", "pending", 2, first.widgets[0]?.instanceId, {
+        reviewReason: "Stale review.",
+      }),
+    ).rejects.toThrow("instance changed");
+    let authorityChecks = 0;
+    await expect(
+      store.grant(boardSession, "refresh", "pending", 2, replacement.widgets[0]?.instanceId, {
+        reviewReason: "Review completed after authority was revoked.",
+        assertCurrent: () => {
+          if (++authorityChecks === 2) {
+            throw new Error("authority revoked");
+          }
+        },
+      }),
+    ).rejects.toThrow("authority revoked");
+    expect(authorityChecks).toBe(2);
+    expect(await store.getSnapshot(boardSession)).toEqual(before);
+  });
+});
