Subject: [PATCH] fix(agents): defer ClawScarf cooldowns to managed inference

ClawScarf-Patch: managed-inference-cooldown
---
 src/agents/auth-profiles/usage-state.ts       |  4 +-
 ...ed-agent.auth-profile-rotation.e2e.test.ts | 75 ++++++++++++++++++-
 2 files changed, 76 insertions(+), 3 deletions(-)

diff --git a/src/agents/auth-profiles/usage-state.ts b/src/agents/auth-profiles/usage-state.ts
index 254c940a9711d3f5fd1f8fcf7f4667a7ed4a2de5..baedd041def264e3cf46ca5e0c8b8cc63ade5c40 100644
--- a/src/agents/auth-profiles/usage-state.ts
+++ b/src/agents/auth-profiles/usage-state.ts
@@ -34,7 +34,9 @@ export function resetAuthProfileFailureState(
 /** Returns true for providers whose auth-profile cooldowns are provider-managed. */
 export function isAuthCooldownBypassedForProvider(provider: string | undefined): boolean {
   const normalized = normalizeProviderId(provider ?? "");
-  return normalized === "openrouter" || normalized === "kilocode";
+  // ClawScarf's scoped credential targets managed LiteLLM; funding and provider
+  // health belong to that gateway, so local cooldowns would outlive a recharge.
+  return normalized === "openrouter" || normalized === "kilocode" || normalized === "clawscarf";
 }
 
 export function resolveInlineProviderApiKeyUsageId(provider: string): string {
