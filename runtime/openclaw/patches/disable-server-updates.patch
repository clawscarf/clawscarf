@@ -0,0 +1,52 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { describe, expect, it, vi } from "vitest";
+import { checkUpdateStatus } from "../../infra/update-check.js";
+import { runGatewayUpdate } from "../../infra/update-runner.js";
+import { withTestDir } from "../../test-helpers/temp-dir.js";
+import { withEnvAsync } from "../../test-utils/env.js";
+import { updateStatusCommand } from "./status.js";
+import { updateFinalizeCommand } from "./update-command-finalize.js";
+import { prepareUpdateCommand } from "./update-command-run.js";
+import { updateRepairCommand } from "./update-repair-command.js";
+import { updateWizardCommand } from "./wizard.js";
+
+describe("distribution-managed core updates", () => {
+  it.each([
+    { name: "CLI update", run: () => prepareUpdateCommand({ yes: true }) },
+    { name: "CLI dry run", run: () => prepareUpdateCommand({ dryRun: true }) },
+    { name: "CLI status", run: () => updateStatusCommand({}) },
+    { name: "CLI wizard", run: () => updateWizardCommand({}) },
+    { name: "CLI repair", run: () => updateRepairCommand({}) },
+    { name: "CLI finalize", run: () => updateFinalizeCommand({}) },
+    { name: "Git runner", run: () => runGatewayUpdate() },
+  ])("refuses $name before probing or creating update state", async ({ run }) => {
+    await withTestDir({ prefix: "openclaw-no-self-update-" }, async (stateDir) => {
+      await withEnvAsync(
+        {
+          OPENCLAW_NO_SELF_UPDATE: "1",
+          OPENCLAW_STATE_DIR: stateDir,
+          OPENCLAW_CONFIG_PATH: path.join(stateDir, "openclaw.json"),
+        },
+        async () => {
+          await expect(run()).rejects.toThrow("OPENCLAW_NO_SELF_UPDATE=1");
+          expect(await fs.readdir(stateDir)).toEqual([]);
+        },
+      );
+    });
+  });
+
+  it("does not contact the registry through a status caller requesting a fresh check", async () => {
+    const fetchSpy = vi.spyOn(globalThis, "fetch");
+    try {
+      await withEnvAsync({ OPENCLAW_NO_SELF_UPDATE: "1" }, async () => {
+        await expect(
+          checkUpdateStatus({ root: null, fetchGit: true, includeRegistry: true }),
+        ).resolves.toEqual({ root: null, installKind: "unknown", packageManager: "unknown" });
+        expect(fetchSpy).not.toHaveBeenCalled();
+      });
+    } finally {
+      fetchSpy.mockRestore();
+    }
+  });
+});
