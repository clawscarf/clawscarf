+        "gateway.auth.trustedProxy.allowUsers",
+        "gateway.auth.identityScopes",
+      ]).restartGateway,
+    ).toBe(false);
+    await state.writeConfig({
+      gateway: {
+        mode: "local",
+        bind: "loopback",
+        trustedProxies: ["127.0.0.1"],
+        auth: {
+          mode: "trusted-proxy",
+          trustedProxy: {
+            userHeader: "x-openclaw-user",
+            allowLoopback: true,
+            allowUsers: [ALICE],
+          },
+          identityScopes: { [ALICE]: ["operator.admin"] },
+        },
