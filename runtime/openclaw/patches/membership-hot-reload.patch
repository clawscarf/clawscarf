+import {
+  createDispatchTestHarness,
+  createOperatorWsClient,
+} from "./authenticated-request-dispatch.test-support.js";
+
+const ALICE = "alice@example.test";
+const BOB = "bob@example.test";
+
+function policy(allowUsers: string[], requiredHeaders?: string[]) {
+  const config: OpenClawConfig = {
+    gateway: {
+      trustedProxies: ["127.0.0.1"],
+      auth: {
+        mode: "trusted-proxy",
+        trustedProxy: { userHeader: "x-openclaw-user", allowUsers, requiredHeaders },
+        identityScopes: { [ALICE]: ["operator.admin"], [BOB]: ["operator.admin"] },
+      },
+    },
+  };
+  const auth = resolveGatewayAuth({ authConfig: config.gateway?.auth, env: {} });
+  return { config, auth };
+}
+
+beforeEach(() => {
+  resetGatewayWorkAdmission();
+});
+afterEach(() => {
+  clearRuntimeConfigSnapshot();
+});
+
+describe("request authority during identity-policy publication", () => {
+  it.each([
+    "unrelated addition",
+    "rejected removal",
+    "committed removal",
+    "committed proxy policy change",
+  ] as const)("uses committed policy for an in-flight request during %s", async (scenario) => {
+    const initial = policy([ALICE, BOB]);
+    const candidate = policy(
+      scenario === "unrelated addition"
+        ? [ALICE, BOB, "carol@example.test"]
+        : scenario === "committed proxy policy change"
+          ? [ALICE, BOB]
+          : [ALICE],
+      scenario === "committed proxy policy change" ? ["x-authenticated-proxy"] : undefined,
+    );
+    const generationState: SharedGatewaySessionGenerationState = {
+      current: resolveSharedGatewaySessionGeneration(
+        initial.auth,
+        initial.config.gateway?.trustedProxies,
+      ),
+      required: null,
+      identityPolicy: initial,
+    };
+    setRuntimeConfigSnapshot(initial.config, initial.config);
+    const identity = scenario === "unrelated addition" ? ALICE : BOB;
+    const client = createOperatorWsClient();
+    const identityGeneration = resolveGatewayIdentityPolicyGeneration({
+      ...initial,
+      identity,
+      method: "trusted-proxy",
+      role: "operator",
+    });
+    if (!identityGeneration) throw new Error("fixture identity was not admitted");
+    client.identityPolicy = {
+      identity,
+      method: "trusted-proxy",
+      role: "operator",
+      generation: identityGeneration,
+    };
+    client.usesSharedGatewayAuth = true;
+    client.sharedGatewaySessionGeneration = generationState.current;
+    const entered = createDeferredCore();
+    const release = createDeferredCore();
+    const persisted = vi.fn();
+    let mutationError: unknown;
+    const harness = createDispatchTestHarness({
+      getRequiredSharedGatewaySessionGeneration:
+        createRequiredSharedGatewaySessionGenerationReader(generationState),
+      extraHandlers: {
+        "test.identity-publication": async (options) => {
+          const authority = readGatewayRequestMutationAuthority(options);
+          expect(authority.family).toBe("worker");
+          entered.resolve();
+          await release.promise;
+          try {
+            if (authority.family !== "worker") throw new Error("missing worker authority");
+            authority.assertWorkerCurrent();
+            persisted();
+          } catch (error) {
+            mutationError = error;
+          }
+          options.respond(true, { persisted: persisted.mock.calls.length });
+        },
+      },
+    });
+    const dispatch = harness.dispatcher.dispatch(
+      { type: "req", id: "publication", method: "test.identity-publication", params: {} },
+      client,
+    );
+    try {
+      await Promise.race([
+        entered.promise,
+        dispatch.then(() => {
+          throw new Error("request did not reach handler");
+        }),
+      ]);
+      // Snapshot activation precedes runtime publication. Simulate its microtask
+      // boundary without treating a prepared candidate as committed authority.
+      setRuntimeConfigSnapshot(candidate.config, candidate.config);
+      generationState.current = resolveSharedGatewaySessionGeneration(
+        candidate.auth,
+        candidate.config.gateway?.trustedProxies,
+      );
+      if (scenario.startsWith("committed")) generationState.identityPolicy = candidate;
+    } finally {
+      release.resolve();
+      await dispatch;
+    }
+    if (scenario.startsWith("committed")) {
+      expect(mutationError).toBeInstanceOf(Error);
+      expect(persisted).not.toHaveBeenCalled();
+      expect(harness.send).not.toHaveBeenCalled();
+      expect(client.invalidated).toBe(true);
+      expect(harness.close).toHaveBeenCalledWith(4001, "identity policy changed");
+    } else {
+      expect(mutationError).toBeUndefined();
+      expect(persisted).toHaveBeenCalledOnce();
+      expect(client.invalidated).not.toBe(true);
+      expect(harness.close).not.toHaveBeenCalled();
+      expect(harness.send).toHaveBeenCalledWith(
+        expect.objectContaining({ id: "publication", ok: true }),
+      );
+      if (scenario === "rejected removal") {
+        setRuntimeConfigSnapshot(initial.config, initial.config);
+        generationState.current = resolveSharedGatewaySessionGeneration(
+          initial.auth,
+          initial.config.gateway?.trustedProxies,
+        );
+        await harness.dispatcher.dispatch(
+          { type: "req", id: "after-rollback", method: "test.identity-publication", params: {} },
+          client,
+        );
+        expect(persisted).toHaveBeenCalledTimes(2);
+        expect(harness.close).not.toHaveBeenCalled();
+        expect(harness.send).toHaveBeenCalledWith(
+          expect.objectContaining({ id: "after-rollback", ok: true }),
+        );
+      }
+    }
+  });
+});
