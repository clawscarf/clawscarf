diff --git a/ui/src/e2e/systems-removal.e2e.test.ts b/ui/src/e2e/systems-removal.e2e.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fd449ee6ef58f293dc5730e5457b80e51b573e91
--- /dev/null
+++ b/ui/src/e2e/systems-removal.e2e.test.ts
@@ -0,0 +1,184 @@
+import path from "node:path";
+import type { Page } from "playwright";
+import { expect, it } from "vitest";
+import { z } from "zod";
+import { installMockGateway } from "../test-helpers/control-ui-e2e.ts";
+import { createControlUiSessionRow } from "../test-helpers/control-ui-session-fixtures.ts";
+import { createControlUiE2eSuite } from "./control-ui-e2e-suite.test-support.ts";
+
+const suite = createControlUiE2eSuite({
+  name: "Systems removal and dashboard navigation mocked Gateway E2E",
+  startServerBeforeBrowser: true,
+});
+
+function installCuratedGateway(page: Page, operatorScopes = ["operator.admin"]) {
+  return installMockGateway(page, {
+    operatorScopes,
+    sessions: Array.from({ length: 30 }, (_, index) =>
+      createControlUiSessionRow(`agent:main:task-${index}`, `Task ${index + 1}`, 30 - index),
+    ),
+    historyMessages: [{ role: "assistant", content: [{ type: "text", text: "Ready to help." }] }],
+    featureMethods: ["environments.list", "node.list", "system.info"],
+    methodResponses: {
+      "environments.list": { environments: [] },
+      "node.list": {
+        nodes: [
+          {
+            nodeId: "browser-node",
+            displayName: "Team browser",
+            platform: "linux",
+            connected: true,
+            paired: true,
+            caps: ["browser"],
+            commands: ["browser.proxy"],
+          },
+        ],
+      },
+      "system.info": { machineName: "Gateway machine" },
+    },
+  });
+}
+
+suite.define(() => {
+  it("scrolls navigation and dashboard sessions together", async () => {
+    const route = "dashboards";
+    await suite.withPage(
+      {
+        locale: "en-US",
+        serviceWorkers: "block",
+        viewport: { width: 1440, height: 900 },
+      },
+      async ({ page }) => {
+        await installCuratedGateway(page);
+        await page.goto(suite.server.baseUrl + route);
+        const home = page.locator(".nav-item--home");
+        const row = page.locator(".sidebar-recent-session").first();
+        await row.waitFor();
+        const showMore = page
+          .locator("openclaw-app-sidebar")
+          .getByRole("button", { name: "Show more" });
+        await showMore.click();
+        await showMore.click();
+        await expect.poll(() => page.locator(".sidebar-recent-session").count()).toBe(30);
+        const homeTop = () => home.evaluate((element) => element.getBoundingClientRect().top);
+        const rowTop = () => row.evaluate((element) => element.getBoundingClientRect().top);
+        await home.hover();
+        await row.hover();
+        const initialHomeTop = await homeTop();
+        const initialRowTop = await rowTop();
+        if (process.env.OPENCLAW_CAPTURE_UI_PROOF === "1") {
+          await page.screenshot({ path: path.join(suite.artifactDir, `${route}-top.png`) });
+        }
+        await page.mouse.wheel(0, 160);
+        await expect.poll(rowTop).toBeLessThan(initialRowTop - 80);
+        if (process.env.OPENCLAW_CAPTURE_UI_PROOF === "1") {
+          await page.screenshot({ path: path.join(suite.artifactDir, `${route}-scrolled.png`) });
+        }
+        await expect
+          .poll(async () => (await homeTop()) - initialHomeTop - ((await rowTop()) - initialRowTop))
+          .toBeCloseTo(0, 0);
+
+        await page.mouse.wheel(0, -1000);
+        await expect.poll(homeTop).toBeCloseTo(initialHomeTop, 0);
+        await home.hover();
+        await page.mouse.wheel(0, 120);
+        await expect.poll(homeTop).toBeLessThan(initialHomeTop - 80);
+        await expect
+          .poll(async () => (await homeTop()) - initialHomeTop - ((await rowTop()) - initialRowTop))
+          .toBeCloseTo(0, 0);
+      },
+    );
+  });
+
+  for (const role of ["admin", "member"] as const) {
+    for (const viewport of [
+      { width: 1440, height: 900 },
+      { width: 390, height: 844 },
+    ]) {
+      it(`removes Systems for ${role} at ${viewport.width}px while retaining chat and browser nodes`, async () => {
+        await suite.withPage(
+          { locale: "en-US", serviceWorkers: "block", viewport },
+          async ({ page }) => {
+            const gateway = await installCuratedGateway(
+              page,
+              role === "admin" ? ["operator.admin"] : ["operator.read", "operator.write"],
+            );
+            await page.goto(`${suite.server.baseUrl}systems`);
+            const composer = page.locator(".agent-chat__composer-combobox textarea");
+            await composer.waitFor({ state: "visible" });
+            expect(new URL(page.url()).pathname).not.toBe("/systems");
+            expect(await page.locator("openclaw-systems-page, .systems-sidebar").count()).toBe(0);
+            for (const method of ["environments.list", "node.list"]) {
+              expect(await gateway.getRequests(method)).toEqual([]);
+            }
+
+            // Chat still reads the Gateway name for its session menu; Systems must not add another read.
+            expect(await gateway.getRequests("system.info")).toHaveLength(1);
+
+            if (viewport.width < 768) {
+              await page.getByRole("button", { name: "Expand sidebar", exact: true }).click();
+            }
+            const sidebar = page.locator("openclaw-app-sidebar");
+            await sidebar.locator(".nav-item--home").waitFor({ state: "visible" });
+            expect(await sidebar.locator('a[href$="/systems"]').count()).toBe(0);
+            await page.screenshot({
+              animations: "disabled",
+              path: path.join(suite.artifactDir, `${role}-${viewport.width}-navigation.png`),
+            });
+            await sidebar.getByRole("button", { name: "Edit pinned items", exact: true }).click();
+            const more = page.locator(".sidebar-more-menu");
+            await more.waitFor({ state: "visible" });
+            expect(await more.locator('[value="systems"]').count()).toBe(0);
+            await more.locator('[value="customize"]').click();
+            const customize = page.locator(".sidebar-pin-editor-menu");
+            await customize.waitFor({ state: "visible" });
+            expect(await customize.locator('[value="systems"]').count()).toBe(0);
+            await page.screenshot({
+              animations: "disabled",
+              path: path.join(suite.artifactDir, `${role}-${viewport.width}-customize.png`),
+            });
+            await page.keyboard.press("Escape");
+            if (viewport.width < 768) {
+              await page.getByRole("button", { name: "Expand sidebar", exact: true }).click();
+            }
+            await sidebar.locator(".nav-item--home").click();
+            await composer.waitFor({ state: "visible" });
+            await composer.fill("Hello");
+            await page.getByRole("button", { name: "Send message", exact: true }).click();
+            const sent = await gateway.waitForRequest("chat.send");
+            const params = z.object({ idempotencyKey: z.string() }).parse(sent.params);
+            await gateway.emitChatFinal({
+              runId: params.idempotencyKey,
+              text: "Chat remains available.",
+            });
+            await page
+              .getByRole("paragraph")
+              .filter({ hasText: "Chat remains available." })
+              .waitFor();
+
+            await page.keyboard.press("ControlOrMeta+k");
+            const input = page.locator(".cmd-palette__input");
+            await input.fill("Systems");
+            await gateway.waitForRequest("sessions.list", { match: { search: "Systems" } });
+            const results = page.locator(".cmd-palette__results");
+            await expect.poll(() => results.getAttribute("aria-busy")).toBe("false");
+            expect(await results.getByRole("option", { name: /^Systems(?:\s|$)/ }).count()).toBe(0);
+            await page.screenshot({
+              animations: "disabled",
+              path: path.join(suite.artifactDir, `${role}-${viewport.width}-search.png`),
+            });
+            await input.press("Escape");
+
+            await page.goto(`${suite.server.baseUrl}settings/devices`);
+            await gateway.waitForRequest("node.list");
+            await page
+              .locator("openclaw-devices-page")
+              .getByText("Team browser", { exact: true })
+              .waitFor();
+            expect(await page.locator("openclaw-systems-page").count()).toBe(0);
+          },
+        );
+      });
+    }
+  }
+});
