            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "defaultModel": {
                      "type": "null"
                    },
                    "models": {
                      "type": "array",
                      "items": {
