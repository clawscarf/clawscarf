+import fs from "node:fs/promises";
+import { expect, it } from "vitest";
+import { createFixtureSkillEntry } from "../test-support/test-helpers.js";
+import { parseSkillFrontmatter, resolveSkillManifestMetadata } from "./frontmatter.js";
+import { buildSkillSnapshot } from "./workspace-skill-prompt.js";
+
+it("removes bundled ClawHub instructions from disabled marketplace prompts and keeps local skills", async () => {
+  const content = await fs.readFile(
+    new URL("../../../skills/clawhub/SKILL.md", import.meta.url),
+    "utf8",
+  );
+  const frontmatter = parseSkillFrontmatter(content);
+  const clawhub = {
+    ...createFixtureSkillEntry("clawhub", { source: "openclaw-bundled" }),
+    frontmatter,
+    metadata: resolveSkillManifestMetadata(frontmatter),
+  };
+  const entries = [clawhub, createFixtureSkillEntry("team-workflow")];
+  const defaults = await buildSkillSnapshot("/workspace", { entries });
+  const disabled = await buildSkillSnapshot("/workspace", {
+    entries,
+    config: { marketplace: { enabled: false } },
+  });
+  expect(defaults.skills.map((skill) => skill.name)).toContain("clawhub");
+  expect(disabled.skills.map((skill) => skill.name)).toEqual(["team-workflow"]);
+  expect(disabled.prompt).not.toContain("clawhub");
+  expect(disabled.prompt).toContain("team-workflow");
+});
