  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "lib": ["ES2024", "DOM"],
    "exactOptionalPropertyTypes": false,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/sdk.tsbuildinfo"
