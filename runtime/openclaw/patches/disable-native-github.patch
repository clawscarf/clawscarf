@@ -0,0 +1,41 @@
+import { afterEach, expect, it, vi } from "vitest";
+import { buildConfigSchemaCore } from "../config/schema.js";
+import { lookupConfigSchema } from "../config/schema.lookup.js";
+import { OpenClawSchema } from "../config/zod-schema.js";
+import { presentConfigSchema } from "./config-schema-presentation.js";
+
+afterEach(() => vi.unstubAllEnvs());
+
+it("hides disabled native GitHub controls while preserving canonical config and shared-auth hints", () => {
+  const canonical = buildConfigSchemaCore();
+  const profileId = "ghp_11111111111111111111111111111111";
+  const retained = {
+    tools: { github: { profileId } },
+    agents: { entries: { main: { tools: { github: { profileId } } } } },
+  };
+  const paths = ["tools.github", "agents.entries.main.tools.github"];
+  vi.stubEnv("OPENCLAW_NO_GITHUB", undefined);
+  expect(presentConfigSchema(canonical)).toBe(canonical);
+  for (const path of paths) {
+    expect(lookupConfigSchema(canonical, path)).not.toBeNull();
+  }
+
+  vi.stubEnv("OPENCLAW_NO_GITHUB", "1");
+  const presented = presentConfigSchema(canonical);
+  for (const path of paths) {
+    expect(lookupConfigSchema(presented, path)).toBeNull();
+    expect(lookupConfigSchema(canonical, path)).not.toBeNull();
+  }
+  expect(Object.keys(presented.uiHints).some((path) => path.startsWith("tools.github"))).toBe(
+    false,
+  );
+  expect(
+    Object.keys(presented.uiHints).some((path) => path.startsWith("agents.entries.*.tools.github")),
+  ).toBe(false);
+  expect(presented.uiHints["gateway.controlUi.github.token"]).toEqual(
+    canonical.uiHints["gateway.controlUi.github.token"],
+  );
+  expect(presented.uiHints["gateway.controlUi.github.token"]?.sensitive).toBe(true);
+  expect(lookupConfigSchema(presented, "tools.exec")).not.toBeNull();
+  expect(OpenClawSchema.safeParse(retained).success).toBe(true);
+});
diff --git a/src/gateway/config-schema-presentation.ts b/src/gateway/config-schema-presentation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4f5c298d7f1d848fd84c32fc2c8127fdd630b673
--- /dev/null
+++ b/src/gateway/config-schema-presentation.ts
@@ -0,0 +1,33 @@
+import { asSchemaObject, type ConfigSchemaResponse } from "../config/schema.shared.js";
+import { isGitHubIntegrationEnabled } from "../infra/github-policy.js";
+
+/** Hide unavailable form controls without changing validation, stored config or redaction hints. */
+export function presentConfigSchema(response: ConfigSchemaResponse): ConfigSchemaResponse {
+  if (isGitHubIntegrationEnabled()) {
+    return response;
+  }
+  const presented = structuredClone(response);
+  const properties = asSchemaObject(presented.schema.properties);
+  const tools = asSchemaObject(properties?.tools);
+  if (tools?.properties) {
+    delete tools.properties.github;
+  }
+  const agents = asSchemaObject(properties?.agents);
+  const entries = asSchemaObject(agents?.properties?.entries);
+  const agent = asSchemaObject(entries?.additionalProperties);
+  const agentTools = asSchemaObject(agent?.properties?.tools);
+  if (agentTools?.properties) {
+    delete agentTools.properties.github;
+  }
+  for (const path of Object.keys(presented.uiHints)) {
+    if (
+      path === "tools.github" ||
+      path.startsWith("tools.github.") ||
+      path === "agents.entries.*.tools.github" ||
+      path.startsWith("agents.entries.*.tools.github.")
+    ) {
+      delete presented.uiHints[path];
+    }
+  }
+  return presented;
+}
