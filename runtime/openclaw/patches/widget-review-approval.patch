diff --git a/ui/src/components/board/board-widget-review.test.ts b/ui/src/components/board/board-widget-review.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c687213186c66d5499633a735e296418b5743ab2
--- /dev/null
+++ b/ui/src/components/board/board-widget-review.test.ts
@@ -0,0 +1,45 @@
+import { render } from "lit";
+import { afterEach, expect, it, vi } from "vitest";
+import { boardWidget } from "./board-view.test-support.ts";
+import { renderBoardPendingCapabilities } from "./board-widget-capabilities.ts";
+import { renderBoardWidgetRejected } from "./board-widget-cell-render.ts";
+
+afterEach(() => {
+  document.body.replaceChildren();
+});
+
+it("explains an explicit denial without offering approval", () => {
+  const onRemove = vi.fn();
+  render(
+    renderBoardWidgetRejected({
+      widget: boardWidget({ grantState: "rejected", reviewReason: "Access explicitly denied." }),
+      disabled: false,
+      onRemove,
+    }),
+    document.body,
+  );
+  const rejected = document.querySelector('[data-test-id="board-rejected"]');
+  expect(rejected?.textContent).toContain("Access explicitly denied.");
+  expect(document.querySelector('[data-test-id="board-grant-allow"]')).toBeNull();
+  rejected?.querySelector<HTMLButtonElement>("button")?.click();
+  expect(onRemove).toHaveBeenCalledOnce();
+});
+it("escapes the review reason and retains the operator approval actions", () => {
+  const reason = '<img src=x onerror="alert(1)"> Confirm prompt access.';
+  const onGrant = vi.fn();
+  render(
+    renderBoardPendingCapabilities({
+      widget: boardWidget({ grantState: "pending", reviewReason: reason }),
+      disabled: false,
+      onGrant,
+    }),
+    document.body,
+  );
+  const pending = document.querySelector('[data-test-id="board-pending"]');
+  expect(pending?.textContent).toContain(reason);
+  expect(pending?.querySelector("img")).toBeNull();
+  document.querySelector<HTMLButtonElement>('[data-test-id="board-grant-allow"]')?.click();
+  expect(onGrant).toHaveBeenCalledWith("granted");
+  document.querySelector<HTMLButtonElement>('[data-test-id="board-grant-reject"]')?.click();
+  expect(onGrant).toHaveBeenCalledWith("rejected");
+});
diff --git a/ui/src/e2e/dashboard-review-approval.e2e.test.ts b/ui/src/e2e/dashboard-review-approval.e2e.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c99cf9d35b345bdd994f636fec2c6d5246dc8d77
--- /dev/null
+++ b/ui/src/e2e/dashboard-review-approval.e2e.test.ts
@@ -0,0 +1,94 @@
+import path from "node:path";
+import { expect, it } from "vitest";
+import type { BoardSnapshot } from "../../../packages/gateway-protocol/src/index.js";
+import { controlUiSessionUrl, installMockGateway } from "../test-helpers/control-ui-e2e.ts";
+import { createControlUiE2eSuite } from "./control-ui-e2e-suite.test-support.ts";
+
+const suite = createControlUiE2eSuite({
+  name: "Dashboard review approval",
+  startServerBeforeBrowser: true,
+});
+const sessionKey = "agent:main:dashboard-review-proof";
+const reason = "Confirm that this widget may send refresh requests to the agent.";
+function snapshot(
+  grantState: "pending" | "rejected" | "granted",
+  reviewReason?: string,
+): BoardSnapshot {
+  return {
+    sessionKey,
+    revision: grantState === "granted" ? 3 : 2,
+    tabs: [{ tabId: "main", title: "Main", position: 0, chatDock: "right" }],
+    widgets: [
+      {
+        name: "refresh-proof",
+        tabId: "main",
+        title: "Refresh permission test",
+        contentKind: "html",
+        sizeW: 8,
+        sizeH: 6,
+        position: 0,
+        revision: 1,
+        instanceId: "synthetic-widget",
+        grantState,
+        declared: { tools: ["prompt"] },
+        ...(reviewReason ? { reviewReason } : {}),
+        ...(grantState === "granted" ? { frameUrl: "about:blank#approved" } : {}),
+      },
+    ],
+  };
+}
+
+suite.define(() => {
+  it("replaces a dead-end rejection with an explained operator decision on desktop and mobile", async () => {
+    const context = await suite.browser.newContext({ viewport: { width: 1280, height: 900 } });
+    const page = await context.newPage();
+    const gateway = await installMockGateway(page, {
+      sessionKey,
+      featureMethods: ["board.get", "board.widget.grant", "chat.metadata", "chat.startup"],
+      methodResponses: { "board.get": snapshot("rejected") },
+    });
+    try {
+      await page.goto(controlUiSessionUrl(suite.server.baseUrl, sessionKey, "dashboard"));
+      await page.locator('[data-test-id="board-rejected"]').waitFor();
+      await page.screenshot({ path: path.join(suite.artifactDir, "before-rejected.png") });
+      await gateway.setMethodResponse("board.get", snapshot("pending", reason));
+      await page.reload();
+      const pending = page.locator('[data-test-id="board-pending"]');
+      await pending.waitFor();
+      expect(await pending.textContent()).toContain(reason);
+      const allow = pending.getByRole("button", { name: "Allow", exact: true });
+      const reject = pending.getByRole("button", { name: "Reject", exact: true });
+      expect(await allow.isEnabled()).toBe(true);
+      expect(await reject.isEnabled()).toBe(true);
+      expect(await page.locator('[data-test-id="board-widget"] iframe').count()).toBe(0);
+      await page.screenshot({ path: path.join(suite.artifactDir, "after-pending-desktop.png") });
+      await page.setViewportSize({ width: 390, height: 844 });
+      await allow.scrollIntoViewIfNeeded();
+      expect(await allow.isVisible()).toBe(true);
+      expect(await reject.isVisible()).toBe(true);
+      await page.screenshot({ path: path.join(suite.artifactDir, "after-pending-mobile.png") });
+      await gateway.setMethodResponse("board.get", snapshot("pending", "x".repeat(500)));
+      await page.reload();
+      await pending.waitFor();
+      await allow.scrollIntoViewIfNeeded();
+      expect(await pending.evaluate((element) => element.scrollWidth <= element.clientWidth)).toBe(
+        true,
+      );
+      expect(await allow.isVisible()).toBe(true);
+      await gateway.setMethodResponse("board.widget.grant", snapshot("granted"));
+      await gateway.setMethodResponse("board.get", snapshot("granted"));
+      await allow.click();
+      const request = await gateway.waitForRequest("board.widget.grant");
+      expect(request.params).toMatchObject({
+        sessionKey,
+        name: "refresh-proof",
+        revision: 1,
+        instanceId: "synthetic-widget",
+        decision: "granted",
+      });
+      await expect.poll(() => pending.count()).toBe(0);
+    } finally {
+      await context.close();
+    }
+  });
+});
