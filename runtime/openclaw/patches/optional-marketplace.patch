+            await gateway.waitForRequest("plugins.catalog.browse");
+            await page.locator(".plugins-hub-header").waitFor();
+            expect(new URL(page.url()).pathname).toBe("/plugins");
+          } else {
+            await page.waitForURL("**/settings/plugins");
+            await page.locator("openclaw-plugins-page").waitFor();
+            expect(await gateway.getRequests("plugins.catalog.browse")).toHaveLength(0);
+            expect(await page.locator(".plugins-hub-header").count()).toBe(0);
+          }
+          const proofDir = capture
+            ? createControlUiE2eArtifactDir(
+                `marketplace-${marketplaceEnabled ? "enabled" : "disabled"}`,
+              )
+            : null;
+          if (proofDir) {
+            await page.screenshot({ path: path.join(proofDir, "plugins-desktop.png") });
+          }
+          await page.goto(`${suite.server.baseUrl}skills`);
+          await gateway.waitForRequest("skills.status");
+          if (marketplaceEnabled) {
+            await gateway.waitForRequest("skills.search");
+          } else {
+            await page.waitForURL("**/settings/skills");
+            await page.locator("openclaw-skills-page").waitFor();
+            expect(await gateway.getRequests("skills.search")).toHaveLength(0);
+            expect(
+              await page.getByRole("button", { name: "Search skills", exact: true }).count(),
+            ).toBe(0);
+          }
+          await page.goto(`${suite.server.baseUrl}apps`);
+          await page.locator("openclaw-apps-page .apps-grid").first().waitFor();
+          expect(await page.locator('a[href="https://clawhub.ai"]').count()).toBe(
+            marketplaceEnabled ? 1 : 0,
+          );
+          if (proofDir) {
+            await page
+              .locator(".apps-section")
+              .filter({ hasText: "In your browser" })
+              .scrollIntoViewIfNeeded();
+            await page.locator(".apps-card__art img").evaluateAll(async (images) => {
+              await Promise.all(
+                images.map((image) => {
+                  if (image instanceof HTMLImageElement) {
+                    image.loading = "eager";
+                    return image.decode();
+                  }
+                  return Promise.resolve();
+                }),
+              );
+            });
+            await page.screenshot({ path: path.join(proofDir, "apps-desktop.png") });
+            await page.setViewportSize({ width: 390, height: 844 });
+            await page
+              .locator(".apps-section")
+              .filter({ hasText: "In your browser" })
+              .scrollIntoViewIfNeeded();
+            await page.screenshot({ path: path.join(proofDir, "apps-mobile.png") });
+          }
+          if (!marketplaceEnabled) {
+            expect(await gateway.getRequests("plugins.catalog.get")).toHaveLength(0);
+            expect(await gateway.getRequests("skills.securityVerdicts")).toHaveLength(0);
+          }
+        },
+      );
+    },
+  );
+});
