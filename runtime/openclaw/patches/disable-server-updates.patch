-  if (!campaign) {
-    return null;
-  }
-  if (campaign.state === "applying") {
-    return t("updates.campaign.applying");
-  }
-  if (campaign.holdUntilMs !== undefined && campaign.holdUntilMs > nowMs) {
-    return t("updates.campaign.held", {
